STATE_DIR = ".nullius"
API_TIMEOUT = 20
# How far an indexed record's year may sit from the preprint's before it is a
# different work rather than the same one.
YEAR_SLACK = 2

READ_DEPTHS = ["abstract", "skim", "method", "replicated"]

# What a claim is allowed to assert, indexed by how far its source was read.
CLAIM_STRENGTHS = ["reports", "holds", "mechanism", "generalises"]
DEPTH_ALLOWS = {
    "abstract": ["reports"],
    "skim": ["reports", "holds"],
    "method": ["reports", "holds", "mechanism"],
    "replicated": ["reports", "holds", "mechanism", "generalises"],
}

WARRANTS = ["measured", "authors-claim", "replicated", "consensus",
            "inferred", "mine-unpublished", "assumed"]

# Ordered weakest to strongest. Independence caps how far up this a claim may go.
STATUSES = ["folklore", "single-result", "emerging", "contested",
            "established", "textbook"]
STATUS_NEEDS_GROUPS = {"established": 2, "textbook": 2, "contested": 2}

UNIT_KINDS = ["read", "survey", "idea", "explain", "interpret", "critique",
              "write", "referee"]

# Not everything worth citing has a DOI. A documentation page, a lecture note, a
# blog post and a book chapter are all legitimate sources; what differs is how
# settled a claim they can carry on their own.
SOURCE_KINDS = ["web", "blog", "docs", "book", "chapter", "thesis", "report",
                "dataset", "software", "talk", "personal-communication"]
STATUS_CEILING = {
    "book": "textbook", "chapter": "textbook", "report": "emerging",
    "thesis": "emerging", "docs": "established", "dataset": "established",
    "software": "established", "web": "emerging", "blog": "emerging",
    "talk": "emerging", "personal-communication": "single-result",
}

VOCABULARY = """## nullius: the commands

Run them as `./.nullius/bin/nullius <cmd>` from the project root.

    start <slug> <kind> "<question>" [--venue V] [--words N] [--artifact PATH]
        kind: read survey idea explain interpret critique write referee
        idea    also needs: kills "<what would end it>" and cost "<what it takes>",
                plus a search with something screened in. All three are enforced.
        survey  needs every retrieved work screened. Enforced.
        write   needs the venue walk and the budget. Enforced.
        interpret  needs decisive "<what would change the conclusion>" before the
                results, and reading "<what it was>" after. Enforced.
        critique / referee  need a verdict, and every finding needs a referent and a
                locator. Zero fatal and zero material means the verdict is the
                positive end of the scale. Enforced.
        read and explain shape what `accept` should say; they are not gated.

    decisive "<what would change the conclusion>" [--post-hoc]    reading "<what it was>"
    scope                                  what the draft itself rules out, and why
    finding <fatal|material|defensible|taste> <structural|evidential|coherence|scope> "<text>" --at L
    findings                               resolve <n> "<what changed>"
    verdict <the venue's scale>            a defensible finding closes permanently
    accept "<a question open right now>"   close "<the answer, with a locator>"
    trade "<what gets cut>"                status       done
    artifact <path> [--excluded]           --excluded: walked, not counted

    cite <doi|arxiv|title>                 resolves, or refuses. never invent one
    cite <url> --kind <docs|blog|book|chapter|thesis|report|dataset|software|talk|web>
         --title "..."                     a source no index carries
    fulltext <citekey>                     a legal copy; caches text when there is one
    quote <citekey> "<text>"               verbatim against that cache, or refuses
    note <citekey> --depth <abstract|skim|method|replicated>
    claim "<text>" --warrant W --status S --strength X --source KEY [--locator L]
        warrant:  measured authors-claim replicated consensus inferred mine-unpublished
        status:   folklore single-result emerging contested established textbook
        strength: reports holds mechanism generalises   -- capped by read depth
    falsify "<idea>" "<why it died>"

    lit "<query>" --vocabulary <name> [--index openalex|arxiv|europepmc]
    snowball [citekey] [--back|--forward|--both]   the citation graph, from what you kept
    screen <search-id> <include|exclude> "<reason>" --index N
    screen <search-id> exclude "<reason>" --below-citations 1     in bulk, by rule
    walk                                   every required section, present/thin/absent
    section "<name>" <planned|elsewhere|n/a> "<why>"
    coverage        check <path>        doctor

Three vocabularies minimum on a survey: yours, the field's own terms taken from the first
hits, and one adjacent field that studies the same thing under another name. Silence is a
failed search, not novelty. `lit` ranks by citations per year, and work too new to have
earned any is shown separately -- judge that band on the abstract."""

