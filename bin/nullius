# --------------------------------------------------------------------- paths


def user_config_path():
    """Contact details belong to the person, not the project. A project's
    config.json is meant to be committed, so an email placed there leaks on the
    first push -- this file sits outside every repository instead."""
    base = os.environ.get("XDG_CONFIG_HOME") or str(Path.home() / ".config")
    return Path(base) / "nullius" / "config.json"


# An index that does not cover a field only adds noise to it: a CS query answered
# by Europe PMC returns endocrinology. These are starting points, not verdicts, and
# `nullius config indexes` overrides any of them.
FIELD_INDEXES = [
    (("medic", "clinic", "health", "bio", "genom", "epidemi", "nursing", "pharma",
      "radiol", "cardio", "onc", "neuro", "imaging", "ecg", "mri"),
     ["openalex", "crossref", "europepmc", "arxiv"]),
    (("comput", "machine learning", "artificial intelligence", " ai", "ml ",
      "algorithm", "software", "nlp", "vision", "robot", "interpretab",
      "optimis", "optimiz", "theory"),
     ["openalex", "crossref", "arxiv"]),
    (("physic", "astro", "math", "statis", "quantum", "geo", "climate", "chem"),
     ["openalex", "crossref", "arxiv"]),
    (("econom", "sociol", "psychol", "polit", "law", "educat", "linguist",
      "philosoph", "histor", "anthropol", "manage", "business"),
     ["openalex", "crossref"]),
]


def indexes_for_field(field):
    low = (field or "").lower()
    for keys, idx in FIELD_INDEXES:
        if any(k in low for k in keys):
            return idx
    return None


def find_root(start=None):
    d = Path(start or os.getcwd()).resolve()
    for cand in [d, *d.parents]:
        if (cand / STATE_DIR / "config.json").is_file():
            return cand
    return None


def require_root():
    root = find_root()
    if root is None:
        die("no nullius project here. Run `nullius init` in the directory your "
            "research lives in.")
    return root


class Store:
    def __init__(self, root):
        self.root = Path(root)
        self.dir = self.root / STATE_DIR

    def p(self, *parts):
        return self.dir.joinpath(*parts)

    def read_json(self, name, default):
        f = self.p(name)
        if not f.is_file():
            return default
        try:
            return json.loads(f.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            return default

    def write_json(self, name, obj):
        f = self.p(name)
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n",
                     encoding="utf-8")

    @property
    def config(self):
        cfg = dict(DEFAULT_CONFIG)
        u = user_config_path()
        layers = []
        if u.is_file():
            try:
                layers.append(json.loads(u.read_text(encoding="utf-8")))
            except json.JSONDecodeError:
                pass
        layers.append(self.read_json("config.json", {}))
        for layer in layers:
            cfg.update({k: v for k, v in layer.items() if v not in ("", None)})
        return cfg

    @property
    def refs(self):
        return self.read_json("refs.json", {})

    def save_refs(self, refs):
        self.write_json("refs.json", refs)

    def claims(self):
        f = self.p("claims.jsonl")
        if not f.is_file():
            return []
        out = []
        for line in f.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line:
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    pass
        return out

    def append_claim(self, claim):
        f = self.p("claims.jsonl")
        f.parent.mkdir(parents=True, exist_ok=True)
        with f.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(claim, ensure_ascii=False) + "\n")

    @property
    def unit(self):
        return self.read_json("work/current.json", None)

    def save_unit(self, unit):
        self.write_json("work/current.json", unit)

    def clear_unit(self):
        f = self.p("work/current.json")
        if f.is_file():
            f.unlink()

    def searches(self):
        d = self.p("searches")
        if not d.is_dir():
            return []
        out = []
        for f in sorted(d.glob("*.json")):
            try:
                out.append(json.loads(f.read_text(encoding="utf-8")))
            except json.JSONDecodeError:
                pass
        return out

    def save_search(self, search):
        self.write_json(f"searches/{search['id']}.json", search)

    def note_path(self, citekey):
        return self.p("papers", f"{citekey}.md")

    def note_depth(self, citekey):
        f = self.note_path(citekey)
        if not f.is_file():
            return None
        m = re.search(r"^read_depth:\s*([a-z]+)\s*$",
                      f.read_text(encoding="utf-8"), re.M)
        return m.group(1) if m else None


# ------------------------------------------------------------------- output


def die(msg, code=1):
    sys.stderr.write(f"nullius: {msg}\n")
    sys.exit(code)


def say(msg):
    sys.stdout.write(msg + "\n")


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def today():
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


# ---------------------------------------------------------------- indexes


def http_json(url):
    req = urllib.request.Request(url, headers={
        "User-Agent": "nullius (+https://github.com/tanyelai/nullius)",
        "Accept": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            return json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise RuntimeError(f"{url} returned HTTP {e.code}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"cannot reach {urllib.parse.urlsplit(url).netloc}: "
                           f"{e.reason}") from e


def http_text(url):
    req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            return r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        if e.code in (403, 404):
            return None
        raise RuntimeError(f"{url} returned HTTP {e.code}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"cannot reach "
                           f"{urllib.parse.urlsplit(url).netloc}: {e.reason}") from e


def strip_html(markup):
    markup = re.sub(r"<(script|style|head)[^>]*>.*?</\1>", " ", markup,
                    flags=re.S | re.I)
    markup = re.sub(r"<[^>]+>", " ", markup)
    markup = (markup.replace("&amp;", "&").replace("&lt;", "<")
              .replace("&gt;", ">").replace("&quot;", '"').replace("&#x2019;", "'")
              .replace("&nbsp;", " "))
    return re.sub(r"[ \t]+", " ", re.sub(r"\n{3,}", "\n\n", markup)).strip()


def openalex(path, contact, **params):
    if contact:
        params["mailto"] = contact
    q = urllib.parse.urlencode({k: v for k, v in params.items() if v not in (None, "")})
    return http_json(f"https://api.openalex.org/{path}" + (f"?{q}" if q else ""))


def crossref_lookup(doi, contact):
    """The DOI registration agency. More authoritative than an aggregator for
    metadata, and it carries the retraction and correction notices."""
    url = ("https://api.crossref.org/works/"
           + urllib.parse.quote(doi, safe="")
           + (f"?mailto={urllib.parse.quote(contact)}" if contact else ""))
    d = http_json(url)
    if not d or "message" not in d:
        return None
    m = d["message"]
    authors = []
    for a in m.get("author") or []:
        name = " ".join(x for x in [a.get("given"), a.get("family")] if x)
        if name:
            authors.append({"id": f"name:{slugify(name, 60)}", "name": name})
    updates = m.get("update-to") or []
    retracted = any((u.get("type") or "").lower() == "retraction" for u in updates)
    year = None
    for key in ("published", "published-print", "published-online", "issued"):
        parts = ((m.get(key) or {}).get("date-parts") or [[None]])[0]
        if parts and parts[0]:
            year = parts[0]
            break
    return {
        "openalex": None, "doi": (m.get("DOI") or "").lower(),
        "title": (m.get("title") or [""])[0],
        "year": year, "type": m.get("type"),
        "venue": (m.get("container-title") or [None])[0],
        "peer_reviewed": m.get("type") in ("journal-article", "proceedings-article",
                                           "book-chapter"),
        "retracted": retracted, "authors": authors, "institutions": [],
        "cited_by": m.get("is-referenced-by-count"),
        "oa_url": None, "referenced_works": [], "resolved_at": now(),
        "index": "crossref", "author_ids": "name",
    }


def europepmc_search(query, limit, counter=None):
    d = http_json("https://www.ebi.ac.uk/europepmc/webservices/rest/search?"
                  + urllib.parse.urlencode({
                      "query": query, "format": "json", "pageSize": limit,
                      "resultType": "core"}))
    if counter is not None:
        counter["europepmc"] = (d or {}).get("hitCount")
    out = []
    for r in ((d or {}).get("resultList") or {}).get("result", []):
        out.append({
            "index": "europepmc", "title": r.get("title", ""),
            "year": int(r.get("pubYear") or 0) or None,
            "doi": (r.get("doi") or "").lower() or None,
            "cited_by": r.get("citedByCount"),
            "venue": r.get("journalTitle"),
            "oa": r.get("isOpenAccess") == "Y",
            "pmcid": r.get("pmcid"),
        })
    return out


def arxiv_query(query):
    """Quoted phrases stay phrases; loose words are ANDed, because `all:a b c` ORs
    them and answered a four-word question with two million matches."""
    parts = re.findall(r'"([^"]+)"', query)
    rest = re.sub(r'"[^"]+"', " ", query)
    terms = [f'all:"{p}"' for p in parts]
    terms += [f"all:{w}" for w in re.findall(r"[\w'-]{3,}", rest)]
    return " AND ".join(terms) or f"all:{query}"


def arxiv_search(query, limit, raw=False, counter=None):
    url = ("https://export.arxiv.org/api/query?"
           + urllib.parse.urlencode({
               "search_query": query if raw else arxiv_query(query),
               "max_results": limit, "sortBy": "relevance"}))
    req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            xml = r.read().decode("utf-8", "replace")
    except (urllib.error.URLError, urllib.error.HTTPError):
        return []
    if counter is not None:
        m = re.search(r"<opensearch:totalResults[^>]*>(\d+)<", xml)
        counter["arxiv"] = int(m.group(1)) if m else None
    out = []
    for entry in xml.split("<entry>")[1:]:
        def tag(name):
            m = re.search(rf"<{name}[^>]*>(.*?)</{name}>", entry, re.S)
            return re.sub(r"\s+", " ", m.group(1)).strip() if m else None
        aid = (tag("id") or "").rsplit("/", 1)[-1].split("v")[0]
        out.append({
            "index": "arxiv", "title": tag("title") or "",
            "year": int((tag("published") or "0000")[:4] or 0) or None,
            "doi": (tag("arxiv:doi") or "").lower() or None,
            "cited_by": None, "venue": "arXiv", "oa": True, "arxiv": aid,
        })
    return out


NOT_A_DOCUMENT = re.compile(r"\.(jpg|jpeg|png|gif|svg|webp|mp4|zip)(\?|$)", re.I)


def document_url(u):
    """An index's `best OA location` is sometimes a graphical abstract. An image is
    not a copy of the paper, and offering one as a route to the text is a lie."""
    return u if u and not NOT_A_DOCUMENT.search(u) else None


def s2_influential(doi, limit):
    """Semantic Scholar marks the citations that actually build on a work. The
    context sentences are sparse, present only where it parsed the citing paper's
    full text, so they are shown when they exist and never promised."""
    try:
        d = http_json(
            f"https://api.semanticscholar.org/graph/v1/paper/DOI:"
            f"{urllib.parse.quote(doi, safe='')}/citations"
            f"?fields=contexts,isInfluential,title,externalIds&limit={limit}")
    except RuntimeError:
        return {}
    out = {}
    for c in (d or {}).get("data") or []:
        pid = (c.get("citingPaper") or {}).get("externalIds") or {}
        key = (pid.get("DOI") or "").lower()
        if key:
            out[key] = {"influential": bool(c.get("isInfluential")),
                        "context": (c.get("contexts") or [None])[0]}
    return out


def unpaywall_locations(doi, contact):
    if not contact:
        return []
    d = http_json(f"https://api.unpaywall.org/v2/{urllib.parse.quote(doi, safe='')}"
                  f"?email={urllib.parse.quote(contact)}")
    out = []
    for loc in ([(d or {}).get("best_oa_location")]
                + ((d or {}).get("oa_locations") or [])):
        if not loc:
            continue
        for field in ("url_for_pdf", "url_for_landing_page", "url"):
            u = document_url(loc.get(field))
            if u and u not in [x[1] for x in out]:
                out.append((f"OA copy ({loc.get('host_type') or 'unknown'})", u))
    return out


def arxiv_copy_of(title):
    """Most paywalled work in these fields has a preprint. Finding it is the
    difference between reading the paper and citing its abstract."""
    want = norm_title(title)
    for hit in (arxiv_search(f'ti:"{title[:120]}"', 5, raw=True)
                or arxiv_search(title, 5)):
        if norm_title(hit.get("title")) == want and hit.get("arxiv"):
            return hit["arxiv"]
    return None


ARXIV_RE = re.compile(r"(?:arxiv[:/ ]|10\.48550/arxiv\.)?(\d{4}\.\d{4,5})(v\d+)?$", re.I)
DOI_RE = re.compile(r"(10\.\d{4,9}/[^\s\"'<>]+)", re.I)


def normalise_identifier(raw):
    """Return ('doi'|'arxiv'|'title', value)."""
    s = raw.strip().rstrip(".,;").replace("abs/", "")
    m = ARXIV_RE.search(s)
    if m:
        return "arxiv", m.group(1)
    m = DOI_RE.search(s)
    if m:
        return "doi", m.group(1).rstrip(".").lower()
    return "title", s


def arxiv_lookup(arxiv_id):
    """arXiv's own API. OpenAlex does not index every arXiv DOI -- 1706.03762 is
    absent -- so the id is turned into a title here and matched by title there."""
    url = ("https://export.arxiv.org/api/query?"
           + urllib.parse.urlencode({"id_list": arxiv_id, "max_results": 1}))
    req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            xml = r.read().decode("utf-8", "replace")
    except (urllib.error.URLError, urllib.error.HTTPError) as e:
        raise RuntimeError(f"cannot reach export.arxiv.org: {e}") from e
    if "<entry>" not in xml:
        return None
    entry = xml.split("<entry>", 1)[1]

    def tag(name):
        m = re.search(rf"<{name}[^>]*>(.*?)</{name}>", entry, re.S)
        return re.sub(r"\s+", " ", m.group(1)).strip() if m else None

    names = [re.sub(r"\s+", " ", n).strip()
             for n in re.findall(r"<author>\s*<name>(.*?)</name>", entry, re.S)]
    return {
        "title": tag("title") or "",
        "year": int((tag("published") or "0000")[:4] or 0) or None,
        "doi": tag("arxiv:doi"),
        "authors": names,
        "abs_url": f"https://arxiv.org/abs/{arxiv_id}",
    }


def record_from_arxiv(meta, arxiv_id):
    """A preprint OpenAlex has no record of. Author identity is matched by name
    here rather than by identifier, which is weaker, and the record says so."""
    return {
        "openalex": None, "arxiv": arxiv_id, "doi": meta.get("doi"),
        "title": meta["title"], "year": meta.get("year"), "type": "preprint",
        "venue": "arXiv", "peer_reviewed": False, "retracted": False,
        "authors": [{"id": f"name:{slugify(n, 60)}", "name": n}
                    for n in meta["authors"]],
        "institutions": [], "cited_by": None, "oa_url": meta["abs_url"],
        "referenced_works": [], "resolved_at": now(), "index": "arxiv",
        "author_ids": "name",
    }


def record_from_openalex(w):
    authors, institutions = [], []
    for a in w.get("authorships") or []:
        au = a.get("author") or {}
        if au.get("id"):
            authors.append({"id": au["id"], "name": au.get("display_name", "")})
        for inst in a.get("institutions") or []:
            if inst.get("id"):
                institutions.append(inst["id"])
    loc = (w.get("primary_location") or {}).get("source") or {}
    return {
        "openalex": w.get("id"),
        "doi": (w.get("doi") or "").replace("https://doi.org/", "") or None,
        "title": w.get("display_name") or w.get("title") or "",
        "year": w.get("publication_year"),
        "type": w.get("type"),
        "venue": loc.get("display_name"),
        "peer_reviewed": (w.get("type") not in ("preprint", None)
                          and not (loc.get("type") == "repository")),
        "retracted": bool(w.get("is_retracted")),
        "authors": authors,
        "institutions": sorted(set(institutions)),
        "cited_by": w.get("cited_by_count"),
        "oa_url": (w.get("open_access") or {}).get("oa_url"),
        "referenced_works": w.get("referenced_works") or [],
        "resolved_at": now(),
        "index": "openalex",
    }


def filter_safe(t):
    """OpenAlex parses its filter values, so punctuation in a title becomes syntax:
    a colon, and a question mark, each return HTTP 400 rather than the work. Keep
    letters, digits, spaces and hyphens, and keep double quotes, because a quoted
    phrase is the only thing that makes the index AND its terms: measured on one
    query, `learning-augmented algorithms prediction error` matched 806 works and
    `"learning-augmented algorithms"` matched 201, and only the second set was the
    subject."""
    kept = re.sub(r"[^0-9A-Za-z\-\" ]", " ", t or "")
    if kept.count('"') % 2:                       # an unclosed quote is not a phrase
        kept = kept.replace('"', " ")
    return re.sub(r"\s+", " ", kept).strip()


def norm_title(t):
    return re.sub(r"[^a-z0-9]+", " ", (t or "").lower()).strip()


def slugify(text, keep=40):
    t = unicodedata.normalize("NFKD", text or "").encode("ascii", "ignore").decode()
    t = re.sub(r"[^a-zA-Z0-9]+", "-", t).strip("-").lower()
    return t[:keep] or "untitled"


def make_citekey(rec, existing):
    surname = ""
    if rec.get("authors"):
        parts = rec["authors"][0]["name"].split()
        if parts:
            surname = slugify(parts[-1], 20).replace("-", "")
    if not surname and rec.get("url"):
        host = urllib.parse.urlsplit(rec["url"]).netloc
        surname = slugify(re.sub(r"^www\.|\.(com|org|net|io|ai|edu|dev)$", "",
                                 host).split(".")[0], 20).replace("-", "")
    if not surname:
        stop = {"the", "a", "an", "on", "of", "in", "for", "and", "to"}
        words = [w for w in slugify(rec.get("title", ""), 80).split("-")
                 if w and w not in stop]
        surname = words[0] if words else "untitled"
    base = f"{surname}{rec.get('year') or 'nd'}"
    key, n = base, 0
    while key in existing:
        n += 1
        key = f"{base}{chr(ord('a') + n - 1)}"
    return key


# ----------------------------------------------------------------- helpers


def strip_markup(text):
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"\\begin\{[^}]*\}|\\end\{[^}]*\}", " ", text)
    text = re.sub(r"\\[a-zA-Z@]+\*?(\[[^\]]*\])*(\{[^{}]*\})*", " ", text)
    text = re.sub(r"[%#*_`$]", " ", text)
    return text


def count_words(text):
    return len(re.findall(r"[A-Za-z0-9][A-Za-z0-9'\u2019-]*", strip_markup(text)))


def cited_keys(text, cfg):
    keys = set()
    for pat in cfg["cite_patterns"]:
        for m in re.finditer(pat, text):
            for k in m.group(1).split(","):
                k = k.strip()
                if k:
                    keys.add(k)
    return keys


def bare_identifiers(text, cfg):
    """A reference does not become a citation by wearing \\cite. Plenty of real drafts
    name a work as `arXiv:2310.15337` in running prose, and a bare identifier is the
    form most likely to be invented, because no bibliography file ever sees it."""
    out = set()
    for pat in cfg.get("bare_identifier_patterns", []):
        for m in re.finditer(pat, text, re.I):
            v = m.group(1).rstrip(".,;")
            out.add(("doi", v.lower()) if v.lower().startswith("10.")
                    else ("arxiv", v))
    return out


DASHES = dict.fromkeys(map(ord, "‐‑‒–—―−"), "-")
APOSTROPHES = dict.fromkeys(map(ord, "‘’ʼ´"), "'")


def fold_name(name):
    """An index writes Ricci-Tersenghi with U+2010 and a draft writes it with an
    ASCII hyphen. They look identical and compare unequal, which would flag a work
    that was cited correctly: the direction of error worth avoiding."""
    n = (name or "").translate(DASHES).translate(APOSTROPHES)
    n = unicodedata.normalize("NFKD", n)
    return "".join(c for c in n if not unicodedata.combining(c)).lower().strip()


def attributed_names(text, cfg):
    """A name is how most prose actually cites. `arXiv:2310.15337` was the easy half;
    "Angelini and Ricci-Tersenghi report" is the half that carries the claim."""
    out = set()
    for pat in cfg.get("attribution_patterns", []):
        for m in re.finditer(pat, text):
            for g in m.groups():
                if g:
                    out.add(g)
    return out


def resolved_surnames(refs):
    out = set()
    for rec in refs.values():
        for a in rec.get("authors", []):
            parts = [w for w in re.split(r"[\s,]+", fold_name(a.get("name", ""))) if w]
            if parts:
                out.add(parts[-1])
                if len(parts) > 2:
                    out.add(" ".join(parts[-2:]))
    return out


def resolved_index(refs):
    """Every identifier the ledger already knows, however it was stored."""
    known = set()
    for rec in refs.values():
        if rec.get("doi"):
            known.add(("doi", rec["doi"].lower()))
        if rec.get("arxiv"):
            known.add(("arxiv", rec["arxiv"]))
    return known


def is_draft(path, cfg):
    return Path(path).suffix.lower() in cfg["draft_extensions"]


def author_groups(refs, citekeys):
    """How many mutually independent author groups these references represent."""
    sets = []
    for k in citekeys:
        rec = refs.get(k)
        if not rec:
            continue
        ids = {a["id"] for a in rec.get("authors", [])}
        placed = False
        for s in sets:
            if s & ids:
                s |= ids
                placed = True
                break
        if not placed and ids:
            sets.append(set(ids))
    return len(sets) if sets else (1 if citekeys else 0)


def tracked_drafts(store, unit, counted_only=False):
    cfg = store.config
    excluded = set((unit or {}).get("excluded", []))
    out = []
    for rel in (unit or {}).get("artifacts", []):
        if counted_only and rel in excluded:
            continue
        f = store.root / rel
        if f.is_file() and is_draft(f, cfg):
            out.append(f)
    return out


# ------------------------------------------------------------------- venues
# A structural finding must cite a line in the venue's own file. That is what stops
# the tool from inventing a requirement, which is where an idealised critique comes
# from: nothing in a call for papers says "add more".

SECTION_DISPOSITIONS = ["planned", "elsewhere", "n/a"]

SEVERITIES = ["fatal", "material", "defensible", "taste"]
GENERATES_WORK = ("fatal", "material")
# A finding cites a required section, a claim whose evidence is missing, or two places
# that conflict. Anything citing none of the three is enhancement: it would be stronger
# with more, which is true of everything ever written.
REFERENTS = ["structural", "evidential", "coherence", "scope"]
DEFAULT_SCALE = ["desk-reject", "major", "minor", "accept"]
# The asks that have no terminating answer. A critique aimed at one of these is not a
# critique; it is an open tap.
EMPTY_ASKS = ["make it better", "improve it", "improve the", "what is missing",
              "what's missing", "polish", "tighten it up", "make it stronger",
              "any feedback", "review it", "look it over"]


def venue_path(store, venue):
    return store.p("venues", f"{venue}.md")


def chunk_offset(haystack, chunk):
    i = haystack.find(chunk)
    return i if i >= 0 else 0


def balanced_group(text, i):
    """Return (contents, index_after) for the {...} starting at i, counting nesting.
    A tabular column spec is `{@{}L{4.8cm}L{10.0cm}@{}}`, and a regex that stops at
    the first closing brace hands the spec back as if it were the first row."""
    if i >= len(text) or text[i] != "{":
        return None, i
    depth, j = 0, i
    while j < len(text):
        if text[j] == "{":
            depth += 1
        elif text[j] == "}":
            depth -= 1
            if depth == 0:
                return text[i + 1:j], j + 1
        j += 1
    return None, i


def tabular_bodies(body):
    """(inner_text, offset_in_body) for every tabular in the section."""
    out = []
    for m in re.finditer(r"\\begin\{tabular\}", body):
        j = m.end()
        if j < len(body) and body[j] == "[":
            k = body.find("]", j)
            j = k + 1 if k >= 0 else j
        spec, j = balanced_group(body, j)
        if spec is None:
            continue
        end = body.find(r"\end{tabular}", j)
        if end < 0:
            continue
        out.append((body[j:end], j))
    return out


def parse_scope(text, cfg):
    """A well-made plan declares what it deliberately does not cover. The tool may
    not require what the venue does not ask for; symmetrically it may not dismiss
    what the artifact does not itself rule out. So the boundary is read from the
    draft rather than kept beside it, where a reviewer would never see it."""
    heads = headings_of(text)
    want = [norm_title(h) for h in cfg.get("scope_headings", [])]
    body, start_line = None, 0
    for i, (level, title, off) in enumerate(heads):
        h = norm_title(title)
        if not any(w and (w in h or h in w) for w in want):
            continue
        end = len(text)
        for level2, _, off2 in heads[i + 1:]:
            if level2 <= level:
                end = off2
                break
        body, start_line = text[off:end], text[:off].count("\n") + 1
        break
    if body is None:
        return None
    rows = []

    # A boundary in a paper is usually a table, and in LaTeX a table row is not a
    # line: cells are separated by & and rows by \\, both wrapping freely.
    for raw_inner, offset in tabular_bodies(body):
        inner = re.sub(r"\\(?:top|mid|bottom)rule|\\hline"
                       r"|\\rowcolor(?:\[[^\]]*\])?\{[^}]*\}"
                       r"|\\multicolumn\{\d+\}\{[^}]*\}", " ", raw_inner)
        for chunk in re.split(r"\\\\", inner):
            if not chunk.strip():
                continue
            cells = [c.strip() for c in re.split(r"(?<!\\)&", chunk)]
            cells = [re.sub(r"\\(?:text(?:bf|it|sc)|emph|small|footnotesize)\s*"
                            r"\{([^{}]*)\}", r"\1", c).strip() for c in cells]
            cells = [re.sub(r"\s+", " ", re.sub(r"\\[a-zA-Z@]+\*?", " ", c)).strip()
                     for c in cells]
            cells = [c for c in cells if c]
            if not cells:
                continue
            head = norm_title(cells[0])
            if head.startswith("deliberately not") or head in (
                    "what", "item", "out of scope", "not done"):
                continue
            rows.append({
                "item": cells[0],
                "reason": " ".join(cells[1:]).strip(),
                "line": start_line + body[:offset + chunk_offset(inner, chunk)]
                        .count("\n")})
    line = start_line
    for raw in body.splitlines():
        line += 1
        item = raw.strip()
        m = re.match(r"^(?:[-*]|\\item(?:\[[^\]]*\])?)\s+(.*)$", item)
        if m:
            content = m.group(1)
        elif item.startswith("|") and item.count("|") >= 3 and \
                not re.match(r"^\|[\s:|-]+\|$", item):
            cells = [c.strip() for c in item.strip("|").split("|")]
            content = " :: ".join(c for c in cells if c)
        else:
            continue
        content = re.sub(r"\\text(bf|it)\{([^}]*)\}", r"\2", content).strip()
        if not content or content.startswith("<"):
            continue
        parts = re.split(r"\s+::\s+|\s+--\s+|:\s+", content, maxsplit=1)
        rows.append({"item": parts[0].strip(),
                     "reason": (parts[1].strip() if len(parts) > 1 else ""),
                     "line": line})
    return {"rows": rows, "line": start_line, "prose": not rows}


def artifact_scope(store, unit):
    cfg = store.config
    for f in tracked_drafts(store, unit):
        got = parse_scope(f.read_text(encoding="utf-8", errors="replace"), cfg)
        if got:
            got["file"] = os.path.relpath(f, store.root)
            return got
    return None


def section_dispositions(store, venue):
    """Kept per venue and section at project level, so a decision taken once is not
    re-asked by every unit that walks the same list afterwards."""
    out = {}
    for key, d in store.read_json("sections.json", {}).items():
        v, _, name = key.partition("::")
        if v == (venue or "-"):
            out[name] = d
    return out


def parse_venue(path, default_min):
    """`- Name | Alias | Alias | min 120` -- one required section per line, under a
    `## Required sections` heading. The threshold lives in the venue file because a
    venue sets it; nothing here has an opinion about how long a section should be."""
    text = path.read_text(encoding="utf-8")
    out = {"words": None, "raw_limit": None, "sections": [], "path": path}

    m = re.search(r"^-?\s*words:\s*(\d+)", text, re.M | re.I)
    if m:
        out["words"] = int(m.group(1))
    m = re.search(r"^-?\s*limit:\s*(.+)$", text, re.M | re.I)
    if m and "<" not in m.group(1):
        out["raw_limit"] = m.group(1).strip()

    block = re.search(r"^##+\s*Required sections\s*$(.*?)(^##\s|\Z)", text,
                      re.M | re.S | re.I)
    if not block:
        return out
    lineno = text[:block.start(1)].count("\n") + 1
    for raw in block.group(1).splitlines():
        lineno += 1
        item = raw.strip()
        if not item.startswith("-"):
            continue
        item = item.lstrip("-").strip()
        if not item or item.startswith("<"):
            continue
        parts = [x.strip() for x in item.split("|") if x.strip()]
        names, minimum = [], default_min
        for part in parts:
            m = re.fullmatch(r"min\s+(\d+)", part, re.I)
            if m:
                minimum = int(m.group(1))
            else:
                names.append(part)
        if names:
            out["sections"].append({"name": names[0], "aliases": names[1:],
                                    "min": minimum, "line": lineno})
    return out


HEADING_RE = re.compile(
    r"^(?:(#{1,6})\s*(.+?)\s*#*$"
    r"|\\(part|chapter|section|subsection|subsubsection|paragraph)\*?"
    r"(?:\[[^\]]*\])?\{(.+?)\})", re.M)
LATEX_LEVEL = {"part": 0, "chapter": 1, "section": 2, "subsection": 3,
               "subsubsection": 4, "paragraph": 5}


def headings_of(text):
    """(level, title, char_offset) for markdown and LaTeX sectioning alike."""
    out = []
    for m in HEADING_RE.finditer(text):
        if m.group(1):
            out.append((len(m.group(1)), m.group(2), m.start()))
        else:
            out.append((LATEX_LEVEL[m.group(3).lower()], m.group(4), m.start()))
    return out


def heading_matches(required, aliases, heading):
    h = norm_title(heading)
    for name in [required] + list(aliases):
        n = norm_title(name)
        if n and (n in h or h in n):
            return True
    return False


def walk_sections(store, unit, venue):
    """Every entry, every run. The guarantee is enumeration, not completeness: a
    section can live inside another one without its own heading, and no textual test
    separates that from an omission. So the author dispositions an absence; the tool
    only refuses to let the list go unlooked-at."""
    drafts = tracked_drafts(store, unit)
    joined = "\n\n".join(f.read_text(encoding="utf-8", errors="replace")
                          for f in drafts)
    heads = headings_of(joined)
    entries = []
    for spec in venue["sections"]:
        hit, words = None, 0
        for i, (level, title, off) in enumerate(heads):
            if not heading_matches(spec["name"], spec["aliases"], title):
                continue
            end = len(joined)
            for level2, _, off2 in heads[i + 1:]:
                if level2 <= level:
                    end = off2
                    break
            hit, words = title, count_words(joined[off:end])
            break
        state = "absent" if hit is None else (
            "thin" if words < spec["min"] else "present")
        entries.append({"name": spec["name"], "state": state, "words": words,
                        "heading": hit, "min": spec["min"], "line": spec["line"]})
    return entries


def cmd_walk(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit. The walk is against a unit's venue "
                             "and its tracked drafts.")
    venue_name = args.venue or unit.get("venue")
    if not venue_name:
        die("this unit declares no venue, so there is no list to walk. "
            "`nullius start ... --venue <name>`.")
    path = venue_path(store, venue_name)
    if not path.is_file():
        die(f"no {os.path.relpath(path, store.root)}. Write it once from the real "
            f"call for papers or author guidelines -- the tool may not require "
            f"anything it cannot cite a line for.")
    venue = parse_venue(path, store.config["section_thin_words"])
    if not venue["sections"]:
        say(f"nullius: {os.path.relpath(path, store.root)} lists no required "
            f"sections, so the walk has nothing to check. Add them under "
            f"`## Required sections`, one per line, from the real document.")
        return
    entries = walk_sections(store, unit, venue)
    disp = section_dispositions(store, venue_name)
    say(f"walking {len(entries)} required sections from "
        f"{os.path.relpath(path, store.root)}")
    for e in entries:
        mark = {"present": "present", "thin": "thin   ", "absent": "ABSENT "}[e["state"]]
        extra = ""
        if e["state"] == "present":
            extra = f"{e['words']} words"
        elif e["state"] == "thin":
            extra = f"{e['words']} words, under the {e['min']} this file sets"
        else:
            d = disp.get(e["name"])
            extra = (f"dispositioned: {d['as']} -- {d['why']}" if d
                     else "no disposition")
        say(f"  {mark}  {e['name']:<30} {extra}")
    undone = [e for e in entries
              if e["state"] == "absent" and e["name"] not in disp]
    if undone:
        say("")
        say("Each absence needs one word about it before the unit can close:")
        for e in undone:
            say(f"  nullius section \"{e['name']}\" "
                f"<planned|elsewhere|n/a> \"<why>\"")
        say("  A section can be present without its own heading, and no textual "
            "test separates that from an omission -- which is why this asks you "
            "rather than deciding.")


def cmd_scope(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    scope = artifact_scope(store, unit)
    if not scope:
        say("nullius: no tracked draft declares a scope boundary. The headings "
            "looked for are in config as `scope_headings`.")
        say("  A plan without one is why review does not converge: a competent "
            "critic can always name another control, so each round adds scope and "
            "the study never starts.")
        return
    say(f"the draft rules these out, at {scope['file']}:{scope['line']}")
    if scope["prose"]:
        say("  the boundary is prose rather than a list, so it can be shown and "
            "not checked. Each exclusion carrying its own reason is what makes it "
            "reviewable instead of a shield.")
    for r in scope["rows"]:
        say(f"  {scope['file']}:{r['line']}  {r['item'][:66]}")
        say(f"      because: {r['reason'] or 'NO REASON GIVEN'}")
    unit["scope_read"] = {"file": scope["file"], "rows": len(scope["rows"]),
                          "when": now()}
    store.save_unit(unit)
    say("")
    say("A suggestion that matches one of these is a decision already taken, not a "
        "gap. If a boundary is itself wrong, that is the one admissible way back "
        "in:")
    say("  nullius finding <fatal|material> scope \"<why this boundary is wrong>\" "
        "--at \"<file:line of the row>\"")


def cmd_section(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    if args.disposition not in SECTION_DISPOSITIONS:
        die(f"disposition must be one of: {', '.join(SECTION_DISPOSITIONS)}")
    if args.disposition == "elsewhere" and not args.why:
        die("`elsewhere` has to name where. That is the whole content of the "
            "claim.")
    venue = unit.get("venue") or "-"
    disp = store.read_json("sections.json", {})
    disp[f"{venue}::{args.name}"] = {"as": args.disposition, "why": args.why or "",
                                     "venue": venue, "section": args.name,
                                     "when": now()}
    store.write_json("sections.json", disp)
    say(f"nullius: '{args.name}' -> {args.disposition}")


# ------------------------------------------------------------------ checks
# A finding is (severity, text). severity is "fact" (blocks in certain mode) or
# "chosen" (a threshold that was picked, so it is reported and marked as such).


def check_draft_text(store, text, label):
    cfg, refs = store.config, store.refs
    facts = []
    known = resolved_index(refs)
    by_id = {}
    for k, rec in refs.items():
        if rec.get("doi"):
            by_id[("doi", rec["doi"].lower())] = k
        if rec.get("arxiv"):
            by_id[("arxiv", rec["arxiv"])] = k
    for kind, value in sorted(bare_identifiers(text, cfg)):
        shown = f"arXiv:{value}" if kind == "arxiv" else value
        if (kind, value) not in known:
            facts.append(f"{label}: `{shown}` is named in the text and has never "
                         f"been resolved. A bare identifier is a citation, and it "
                         f"is the form most likely to be invented -- no "
                         f"bibliography ever checks it. `nullius cite {value}`.")
        elif refs[by_id[(kind, value)]].get("retracted"):
            facts.append(f"{label}: `{shown}` is named in the text and the index "
                         f"records it as RETRACTED.")
    known_names = resolved_surnames(refs)
    for name in sorted(attributed_names(text, cfg)):
        low = fold_name(name)
        if low in known_names or any(low in n.split() for n in known_names):
            continue
        facts.append(f"{label}: the text attributes something to `{name}` and no "
                     f"resolved reference has an author of that name. A name is a "
                     f"citation -- it is how most prose actually cites -- and it "
                     f"is the form nothing else checks. `nullius cite` the work, "
                     f"or drop the attribution.")
    for key in sorted(cited_keys(text, cfg)):
        rec = refs.get(key)
        if rec is None:
            facts.append(f"{label}: `{key}` is cited but not resolved. "
                         f"Run `nullius cite <doi|arxiv|title>` first -- an "
                         f"identifier that never resolved cannot reach a draft.")
        elif rec.get("retracted"):
            facts.append(f"{label}: `{key}` is cited and the index records it as "
                         f"RETRACTED ({rec.get('title', '')[:60]}).")
    return facts


def check_attribution(store, text, label):
    """Reported, never blocking: a weak claim rendered as a bare assertion."""
    cfg = store.config
    out = []
    sentences = re.split(r"(?<=[.!?])\s+", strip_markup(text))
    for claim in store.claims():
        if claim.get("status") not in ("single-result", "folklore") and \
           claim.get("warrant") != "authors-claim":
            continue
        probe = " ".join(claim["text"].split()[:6]).lower()
        if len(probe) < 12:
            continue
        for s in sentences:
            low = s.lower()
            if probe in low:
                cued = any(c in low for c in cfg["attribution_cues"]) or \
                    any(src in s for src in claim.get("sources", []))
                if not cued:
                    out.append(f"{label}: claim {claim['id']} is "
                               f"`{claim.get('status')}` / "
                               f"`{claim.get('warrant')}` but reads as a bare "
                               f"assertion here. Attribute and situate it.")
                break
    return out


def effective_budget(store, unit, cfg):
    """The unit's own figure if it declared one, otherwise the venue's. Read here
    rather than copied at start, so editing the venue file moves every unit that
    targets it instead of leaving a stale snapshot behind."""
    declared = (unit.get("budget") or {}).get("words")
    if declared:
        return declared, "declared for this unit"
    name = unit.get("venue")
    if not name:
        return None, None
    vpath = venue_path(store, name)
    if not vpath.is_file():
        return None, None
    words = parse_venue(vpath, cfg["section_thin_words"])["words"]
    return (words, f"{os.path.relpath(vpath, store.root)}") if words else (None, None)


def closed_work_count(store):
    """Fatal and material findings closed, across every unit this project has run."""
    n = 0
    for f in (store.unit or {}).get("findings", []):
        if f.get("resolved") and f["severity"] in GENERATES_WORK:
            n += 1
    log = store.p("work", "log.jsonl")
    if log.is_file():
        for line in log.read_text(encoding="utf-8").splitlines():
            try:
                unit = json.loads(line)
            except json.JSONDecodeError:
                continue
            for f in unit.get("findings", []):
                if f.get("resolved") and f["severity"] in GENERATES_WORK:
                    n += 1
    return n


def sample_growth(store):
    """One row per artifact whenever its measured state moves. Sampled at the stop
    rather than on every command, so the series counts turns rather than keystrokes."""
    unit = store.unit
    if not unit:
        return
    closed = closed_work_count(store)
    path = store.p("growth.jsonl")
    last = {}
    if path.is_file():
        for line in path.read_text(encoding="utf-8").splitlines():
            try:
                row = json.loads(line)
            except json.JSONDecodeError:
                continue
            last[row["artifact"]] = row
    rows = []
    for f in tracked_drafts(store, unit, counted_only=True):
        rel = os.path.relpath(f, store.root)
        words = count_words(f.read_text(encoding="utf-8", errors="replace"))
        prev = last.get(rel)
        if prev and prev["words"] == words and prev["closed"] == closed:
            continue
        rows.append({"when": now(), "artifact": rel, "words": words,
                     "closed": closed, "unit": unit["slug"], "kind": unit["kind"]})
    if rows:
        path.parent.mkdir(parents=True, exist_ok=True)
        with path.open("a", encoding="utf-8") as fh:
            for r in rows:
                fh.write(json.dumps(r, ensure_ascii=False) + "\n")


def extension_signal(store, cfg):
    """Growth is not the signal. Growth with nothing closed is."""
    path = store.p("growth.jsonl")
    if not path.is_file():
        return []
    series = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        try:
            row = json.loads(line)
        except json.JSONDecodeError:
            continue
        series.setdefault(row["artifact"], []).append(row)
    out = []
    window, ratio = cfg["extension_window"], cfg["extension_growth"]
    for artifact, rows in series.items():
        if len(rows) < window:
            continue
        first, last = rows[-window], rows[-1]
        if not first["words"]:
            continue
        grew = last["words"] / first["words"]
        if grew >= ratio and last["closed"] <= first["closed"]:
            out.append(
                f"{artifact}: {window} turns, {first['words']} to {last['words']} "
                f"words, and no finding that generates work closed in that span. "
                f"Growth is not the signal; growth with nothing closed is. If the "
                f"last real gap is shut, the answer is a verdict rather than "
                f"another pass.")
    return out


def unit_findings(store):
    """Everything the Stop gate asks. Returns (facts, chosen)."""
    cfg = store.config
    unit = store.unit
    facts, chosen = [], []
    if not unit:
        return facts, chosen

    if not unit.get("accept"):
        facts.append("no acceptance question. `nullius accept \"<what would "
                     "close this>\"` -- a unit with no stated close is a unit "
                     "that cannot be finished, only abandoned.")
    elif not unit.get("accept_closed"):
        facts.append(f"the acceptance question is still open:\n      "
                     f"\"{unit['accept']}\"\n    Close it with `nullius close "
                     f"\"<the answer, with its locator>\"`.")

    for f in tracked_drafts(store, unit):
        text = f.read_text(encoding="utf-8", errors="replace")
        rel = os.path.relpath(f, store.root)
        facts += check_draft_text(store, text, rel)
        chosen += check_attribution(store, text, rel)

    if unit.get("kind") == "idea":
        # The vocabulary has always said an idea unit needs these three. Until now it
        # only said it, which is the exact failure this tool exists to replace.
        searches = store.searches()
        screened_in = [r for sr in searches for r in sr.get("results", [])
                       if r.get("screened") == "include"]
        if not searches:
            facts.append("an idea unit with no search logged. Silence is a failed "
                         "search rather than novelty, so the neighbour set has to "
                         "be looked for before the idea can be called open.")
        elif not screened_in:
            facts.append(f"{len(searches)} search(es) logged and nothing screened "
                         f"in. An empty neighbour set is a red flag, not a green "
                         f"light: it usually means the terms were wrong. Include "
                         f"the nearest work even when it is not close, or record "
                         f"why the field genuinely has none.")
        if not unit.get("kills"):
            facts.append("no killing assumption. `nullius kills \"<what would make "
                         "you abandon this>\"` -- an idea no observation could end "
                         "is not a test.")
        if not unit.get("cost"):
            facts.append("no cost estimate. `nullius cost \"<data, compute, access, "
                         "approvals, calendar>\"` -- the ideas that die late are the "
                         "ones nobody priced early.")

    if unit.get("kind") == "interpret":
        if not unit.get("decisive"):
            facts.append("no decisive observation named. `nullius decisive \"<the "
                         "number that would change your conclusion>\"` -- named "
                         "after the results it is not a prediction, and the whole "
                         "value of this unit kind is the ordering.")
        elif not unit.get("reading"):
            facts.append(f"named what would change the conclusion and never "
                         f"recorded what was actually observed. `nullius reading "
                         f"\"<what the number was>\"`.")
        if (unit.get("decisive") or {}).get("post_hoc"):
            chosen.append("this interpretation was framed after the results were "
                          "in. That is exploratory, which is legitimate, and it "
                          "has to travel with the conclusion rather than be "
                          "dropped when the paragraph is written.")

    if unit.get("kind") in ("critique", "referee"):
        if not tracked_drafts(store, unit):
            facts.append("this unit reviews nothing. `nullius artifact <path>` -- "
                         "without it the completeness walk cannot run, the limit "
                         "cannot be checked, and a finding has nowhere to point.")
        low = (unit.get("accept") or "").lower()
        hit = next((a for a in EMPTY_ASKS if a in low), None)
        if hit:
            facts.append(f"this critique accepts on \"{hit}\", which has no "
                         f"terminating answer. Name the decision it has to enable "
                         f"instead: whether this goes out, whether the design can "
                         f"answer the question, which of two framings to keep.")
        findings = unit.get("findings") or []
        blank = [f for f in findings if not f.get("at")]
        if blank:
            facts.append(f"{len(blank)} finding(s) with no locator.")
        scope = artifact_scope(store, unit)
        if scope and not unit.get("scope_read"):
            facts.append(f"the draft declares a scope boundary at "
                         f"{scope['file']}:{scope['line']} and this unit has not "
                         f"read it. `nullius scope`. Review on a plan does not "
                         f"otherwise converge: a competent critic can always name "
                         f"another control, so without a written boundary each "
                         f"round adds scope and the work never starts.")
        elif scope:
            unreasoned = [r for r in scope["rows"] if not r["reason"]]
            if unreasoned:
                facts.append(
                    "the scope boundary has rows that exclude something without "
                    "saying why:\n      "
                    + "\n      ".join(f"{scope['file']}:{r['line']}  {r['item'][:56]}"
                                       for r in unreasoned)
                    + "\n    Out by decision, with the decision missing, is a "
                      "shield rather than a boundary.")
        verdict = (unit.get("verdict") or {}).get("recommendation")
        if not verdict:
            facts.append(f"no recommendation. `nullius verdict <"
                         f"{'|'.join(venue_scale(store, unit))}>` -- findings "
                         f"without one leave the author to guess what they add up "
                         f"to, which is the guess this unit exists to remove.")
        else:
            work = [f for f in findings if f["severity"] in GENERATES_WORK]
            positive = verdict in ("accept", "minor", "submit")
            if not work and not positive:
                facts.append(
                    f"zero fatal and zero material findings, and the "
                    f"recommendation is `{verdict}`. With nothing that generates "
                    f"work, the honest recommendation is the positive end of the "
                    f"scale. Producing more findings past this point is pressure "
                    f"rather than rigour.")
            if work and positive:
                chosen.append(f"{len(work)} finding(s) that generate work, and a "
                              f"recommendation of `{verdict}`. Consistent only if "
                              f"the author can address them without a re-review.")

    if unit.get("kind") == "survey":
        state = snowball_state(store)
        unwalked = []
        for sr in store.searches():
            for r in sr.get("results", []):
                if r.get("screened") == "include" and r.get("openalex") and \
                        openalex_short(r["openalex"]) not in state:
                    unwalked.append(r.get("title", "")[:52])
        offgraph = [r.get("title", "")[:52] for sr in store.searches()
                    for r in sr.get("results", [])
                    if r.get("screened") == "include" and not r.get("openalex")]
        if offgraph:
            chosen.append(f"{len(offgraph)} work(s) you kept carry no index record, "
                          f"so the citation graph cannot be walked from them: "
                          + "; ".join(sorted(set(offgraph))[:3])
                          + ". Resolve them with `nullius cite` if they matter.")
        if unwalked:
            facts.append(
                f"{len(unwalked)} work(s) you screened in have never been walked:\n"
                "      " + "\n      ".join(sorted(set(unwalked))[:6])
                + "\n    `nullius snowball`. A query finds what shares your words; "
                  "the citation graph finds what the field itself linked, and it "
                  "is the only thing a closed frontier can rest on.")

        unscreened = sum(1 for s in store.searches()
                         for w in s.get("results", [])
                         if w.get("screened") is None)
        if unscreened:
            facts.append(f"this is a survey unit and {unscreened} retrieved "
                         f"works were never screened. `nullius coverage` lists "
                         f"them; screen or exclude each with a reason.")
        vocabs = len({s.get("vocabulary") for s in store.searches()
                      if s.get("vocabulary")})
        want = cfg["vocabularies_suggested"]
        if vocabs < want:
            chosen.append(f"{vocabs} query vocabular"
                          f"{'y' if vocabs == 1 else 'ies'} logged against a "
                          f"suggested {want}. Your framing is not the field's "
                          f"framing, and that is how a literature goes missing.")

    venue_name = unit.get("venue")
    if venue_name:
        vpath = venue_path(store, venue_name)
        if not vpath.is_file():
            facts.append(f"this unit targets `{venue_name}` and there is no "
                         f"{os.path.relpath(vpath, store.root)}. Write it once from "
                         f"the real call or author guidelines -- a structural "
                         f"finding has to cite a line in it, so without the file "
                         f"nothing can be required of the draft and nothing can be "
                         f"checked.")
        else:
            venue = parse_venue(vpath, cfg["section_thin_words"])
            if not venue["sections"]:
                chosen.append(f"{os.path.relpath(vpath, store.root)} lists no "
                              f"required sections, so the completeness walk has "
                              f"nothing to check.")
            elif tracked_drafts(store, unit):
                entries = walk_sections(store, unit, venue)
                disp = section_dispositions(store, venue_name)
                undone = [e for e in entries
                          if e["state"] == "absent" and e["name"] not in disp]
                if undone:
                    facts.append(
                        "the completeness walk has entries you have not looked at:\n      "
                        + "\n      ".join(
                            f"ABSENT  {e['name']}  ({os.path.relpath(vpath, store.root)}"
                            f":{e['line']})" for e in undone)
                        + "\n    Each needs one word -- `nullius section \"<name>\" "
                          "<planned|elsewhere|n/a> \"<why>\"`. The list is walked "
                          "rather than sampled, which is the only reason \"it never "
                          "told me\" cannot happen; what you do about an absence "
                          "stays yours.")
                thin = [e for e in entries if e["state"] == "thin"]
                if thin:
                    chosen.append(
                        "thin against the minimum that venue file sets: "
                        + "; ".join(f"{e['name']} {e['words']}/{e['min']}"
                                    for e in thin)
                        + ". A word count is a chosen threshold, not a fact about "
                          "whether the section does its job.")

    budget, _ = effective_budget(store, unit, cfg)
    if budget and not tracked_drafts(store, unit, counted_only=True):
        facts.append(f"a budget of {budget} words is declared and no draft is "
                     f"tracked against it, so nothing is measuring it. "
                     f"`nullius artifact <path>`, or drop the budget.")
    elif budget:
        words = sum(count_words(f.read_text(encoding="utf-8", errors="replace"))
                    for f in tracked_drafts(store, unit, counted_only=True))
        if words > budget and not unit.get("trade"):
            facts.append(f"{words} words against a declared budget of {budget}. "
                         f"Over budget an addition is a trade, not an addition: "
                         f"record what it costs with `nullius trade \"<what "
                         f"gets cut>\"`, or subtract.")

    named = [c for c in store.claims()
             if c.get("independence_by_name")
             and c.get("status") in STATUS_NEEDS_GROUPS]
    if named:
        chosen.append(f"{len(named)} claim(s) reach their status through author "
                      f"names rather than identifiers. Two spellings of one "
                      f"person read as two groups, so the independence is "
                      f"weaker than the label suggests.")

    chosen += extension_signal(store, cfg)

    singles = [c for c in store.claims() if len(c.get("sources", [])) == 1]
    if singles:
        chosen.append(f"{len(singles)} claim(s) rest on a single source. That is "
                      f"a fact about the evidence, not a defect -- but it "
                      f"travels with the claim.")
    return facts, chosen


# ---------------------------------------------------------------- commands


def cmd_init(args):
    root = Path(args.path or os.getcwd()).resolve()
    store = Store(root)
    if store.p("config.json").is_file() and not args.force:
        die(f"already initialised at {store.dir}. Pass --force to rewrite config.")
    cfg = {k: v for k, v in DEFAULT_CONFIG.items() if k != "contact"}
    picked = None
    if args.field:
        cfg["field"] = args.field
        picked = indexes_for_field(args.field)
        if picked:
            cfg["indexes"] = picked
    store.write_json("config.json", cfg)
    if args.email:
        upath = user_config_path()
        upath.parent.mkdir(parents=True, exist_ok=True)
        existing = {}
        if upath.is_file():
            try:
                existing = json.loads(upath.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                pass
        existing["contact"] = args.email
        upath.write_text(json.dumps(existing, indent=2) + "\n", encoding="utf-8")
    for d in ("papers", "threads", "searches", "venues", "work", "cache"):
        store.p(d).mkdir(parents=True, exist_ok=True)
    tpl = Path(__file__).resolve().parent.parent / "templates"
    for name, dest in (("program.md", "program.md"), ("field.md", "field.md"),
                       ("venue.md", "venues/EXAMPLE.md")):
        src, out = tpl / name, store.p(dest)
        if src.is_file() and not out.is_file():
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(src.read_text(encoding="utf-8"), encoding="utf-8")
    for name, head in (("falsified.md", "# Falsified\n\nIdeas that died, and what "
                        "killed them. Injected before a write on the thread that "
                        "would repeat them.\n"),
                       ("decisions.md", "# Decisions\n\nMethodological choices, "
                        "with the alternative that was rejected.\n"),
                       ("terms.md", "# Terms\n\nWords this literature uses two "
                        "ways, and each paper's operationalisation.\n")):
        f = store.p(name)
        if not f.is_file():
            f.write_text(head, encoding="utf-8")
    shim = store.p("bin", "nullius")
    shim.parent.mkdir(parents=True, exist_ok=True)
    shim.write_text('#!/usr/bin/env bash\nexec python3 "%s" "$@"\n'
                    % Path(__file__).resolve(), encoding="utf-8")
    shim.chmod(0o755)
    gi = store.p(".gitignore")
    if not gi.is_file():
        gi.write_text("work/\ncache/\nbin/\n", encoding="utf-8")
    say(f"nullius: initialised {store.dir}")
    say(f"  run it from here as ./{STATE_DIR}/bin/nullius")
    if picked:
        say(f"  indexes for that field: {', '.join(picked)}")
        say(f"  a starting point, not a verdict. `nullius config indexes` if it is "
            f"wrong, and `nullius lit --index <name>` overrides it once.")
    elif args.field:
        say(f"  no index preset matched \"{args.field}\", so all of "
            f"{', '.join(DEFAULT_CONFIG['indexes'])} are on. An index that does not "
            f"cover your field only adds noise to it.")
    if not store.config.get("contact"):
        say("  set a contact email -- it is not a login and gives no access to "
            "anything paywalled, but Unpaywall refuses the request without one\n"
            "  (HTTP 422), which is the whole route to preprint copies, and "
            "OpenAlex and Crossref use it for their polite pool:\n"
            "    nullius config contact you@university.edu")
    say("  next: describe your field in .nullius/field.md, and your target "
        "venue in .nullius/venues/.")


def cmd_config(args):
    upath = user_config_path()
    if args.value is None:
        store = Store(require_root())
        merged = store.config
        if args.key:
            say(json.dumps(merged.get(args.key), ensure_ascii=False))
        else:
            say(json.dumps(merged, indent=2, ensure_ascii=False))
        return
    val = int(args.value) if args.value.isdigit() else args.value
    if args.user or args.key == "contact":
        upath.parent.mkdir(parents=True, exist_ok=True)
        cfg = {}
        if upath.is_file():
            try:
                cfg = json.loads(upath.read_text(encoding="utf-8"))
            except json.JSONDecodeError:
                pass
        cfg[args.key] = val
        upath.write_text(json.dumps(cfg, indent=2) + "\n", encoding="utf-8")
        say(f"nullius: {args.key} = {val}  ({upath})")
        if args.key == "contact":
            say("  kept outside the project so it cannot reach a commit. Pass "
                "--user to put anything else here too.")
        return
    store = Store(require_root())
    cfg = store.read_json("config.json", {})
    cfg[args.key] = val
    store.write_json("config.json", cfg)
    say(f"nullius: {args.key} = {val}  (.nullius/config.json, committed)")


def cmd_start(args):
    store = Store(require_root())
    if store.unit and not args.force:
        u = store.unit
        die(f"a unit is already open: {u['slug']} ({u['kind']}). Finish it with "
            f"`nullius done`, or pass --force to replace it.")
    if args.kind not in UNIT_KINDS:
        die(f"kind must be one of: {', '.join(UNIT_KINDS)}")
    budget = {}
    venue_name = args.venue or store.config.get("default_venue") or ""
    if args.words:
        budget["words"] = args.words
    unit = {
        "slug": args.slug, "kind": args.kind, "question": args.question,
        "venue": venue_name,
        "budget": budget, "accept": None, "accept_closed": False,
        "artifacts": list(args.artifact or []), "trade": None,
        "started": now(),
    }
    store.save_unit(unit)
    say(f"nullius: unit '{args.slug}' open ({args.kind})")
    say(f"  now declare what would close it, before the work:\n"
        f"    nullius accept \"<a question that is open right now>\"")


def cmd_accept(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit. `nullius start` first.")
    if unit.get("accept") and not args.force:
        die(f"this unit already accepts on:\n  \"{unit['accept']}\"\n"
            f"Changing it mid-flight is moving the goalposts. Pass --force if "
            f"the question itself turned out to be wrong.")
    unit["accept"] = args.question
    unit["accept_closed"] = False
    store.save_unit(unit)
    say(f"nullius: accepted. This unit is finishable when that question is "
        f"answered with a locator.")


def cmd_close(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    if not unit.get("accept"):
        die("nothing to close -- no acceptance question was declared.")
    # A locator is anything the next reader can turn to. A named part of a paper
    # counts; "yes it is" does not.
    locator = "|".join([
        r"\w+:[\w./#-]+",
        r"\u00a7\s*[\w.-]+",
        r"\b(?:table|fig(?:ure)?|section|sec|eq(?:uation)?|p{1,2}|page|chapter|"
        r"appendix|listing|algorithm|line)\.?\s*[\w.-]*\d",
        r"\b(?:abstract|introduction|methods?|materials|results?|discussion|"
        r"conclusions?|limitations|related work|appendix|supplement\w*)\b",
        r"\b\w[\w-]*\s+section\b",
        r"\bsection\s+\w[\w-]*",
    ])
    if not re.search(locator, args.answer, re.I):
        die("that answer carries no locator. An acceptance answer has to be "
            "re-checkable by the next reader -- draft.tex:88, Table 2, \u00a73.1, "
            "p. 7, or a named section such as Methods. Otherwise it is an "
            "assertion about your own work, and you are the one person who "
            "cannot check it.")
    unit["accept_closed"] = True
    unit["accept_answer"] = args.answer
    store.save_unit(unit)
    say("nullius: acceptance closed.")


def venue_scale(store, unit):
    name = unit.get("venue")
    if not name:
        return DEFAULT_SCALE
    path = venue_path(store, name)
    if not path.is_file():
        return DEFAULT_SCALE
    m = re.search(r"^##+\s*Recommendation scale\s*$(.*?)(^##\s|\Z)",
                  path.read_text(encoding="utf-8"), re.M | re.S | re.I)
    if not m:
        return DEFAULT_SCALE
    words = [w.strip().lower() for w in re.split(r"[/,\n]", m.group(1))
             if w.strip() and not w.strip().startswith("<")]
    return words or DEFAULT_SCALE


def discharged_findings(store):
    f = store.p("discharged.md")
    if not f.is_file():
        return []
    return re.findall(r"^## (.+)$", f.read_text(encoding="utf-8"), re.M)


def cmd_decisive(args):
    """The number that would change the conclusion, named before the results are
    opened. Named afterwards it is not a prediction, which is a fact about the
    ordering rather than a judgement about the person."""
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    have_results = any(c.get("warrant") == "mine-unpublished" for c in store.claims())
    if have_results and not args.post_hoc:
        die("your own unpublished results are already in the ledger, so this is "
            "being named after the fact. That is legitimate and common, and it is "
            "a different kind of claim. Say so: --post-hoc.")
    unit["decisive"] = {"text": args.text, "when": now(),
                        "post_hoc": bool(args.post_hoc or have_results)}
    store.save_unit(unit)
    say("nullius: recorded" + (" as post-hoc" if unit["decisive"]["post_hoc"] else ""))
    if unit["decisive"]["post_hoc"]:
        say("  exploratory, and it travels with the conclusion. What is not "
            "allowed is presenting it as confirmatory later.")


def cmd_reading(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    if not unit.get("decisive"):
        die("nothing to read against. `nullius decisive \"<what would change the "
            "conclusion>\"` first, which is the whole point of the ordering.")
    unit["reading"] = {"text": args.text, "when": now()}
    store.save_unit(unit)
    say("nullius: recorded against \"" + unit["decisive"]["text"][:60] + "\"")


def cmd_finding(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    if args.severity not in SEVERITIES:
        die(f"severity must be one of: {', '.join(SEVERITIES)}")
    if args.referent not in REFERENTS:
        die(f"a finding cites one of: {', '.join(REFERENTS)}. One that cites none "
            f"of them is enhancement, which is true of every text ever written and "
            f"is the one kind that never runs out.")
    if not args.at:
        die("--at is required. A finding without a locator cannot be acted on and "
            "cannot be disagreed with.")
    scope = artifact_scope(store, unit)
    if scope and args.referent != "scope" and not unit.get("scope_read"):
        sys.stderr.write(
            f"nullius: this draft declares its own scope boundary at "
            f"{scope['file']}:{scope['line']}, and it has not been read in this "
            f"unit. Read it first -- `nullius scope`. A suggestion that matches a "
            f"row there is a decision already taken rather than a gap, and no "
            f"textual test can tell the two apart, which is why you are being "
            f"asked rather than filtered.\n")
        sys.exit(1)
    norm = norm_title(args.text)
    if scope and args.referent != "scope":
        terms = {w for w in norm.split() if len(w) > 4}
        for r in scope["rows"]:
            shared = terms & {w for w in norm_title(r["item"]).split() if len(w) > 4}
            if len(shared) >= 3:
                say(f"  note: shares {', '.join(sorted(shared))} with the boundary "
                    f"row at {scope['file']}:{r['line']}. A lead, not a verdict.")
                break
    for old in discharged_findings(store):
        o = norm_title(old)
        if o and (o in norm or norm in o):
            die(f"this was discharged already:\n  \"{old}\"\nA defensible finding "
                f"closes once, with a sentence in Limitations, and does not come "
                f"back. Re-raising it is how a finished draft becomes an infinite "
                f"project.")
    unit.setdefault("findings", []).append({
        "severity": args.severity, "referent": args.referent, "text": args.text,
        "at": args.at, "when": now()})
    store.save_unit(unit)
    say(f"nullius: {args.severity} / {args.referent} at {args.at}")
    if args.severity == "defensible":
        f = store.p("discharged.md")
        prev = f.read_text(encoding="utf-8") if f.is_file() else (
            "# Discharged\n\nDefensible findings, closed with one sentence in "
            "Limitations. These do not come back.\n")
        f.write_text(prev.rstrip() + f"\n\n## {args.text}\n\n- at: {args.at}\n"
                     f"- discharged: {today()}\n", encoding="utf-8")
        say("  a property of the study rather than a defect in it. One sentence in "
            "Limitations closes it permanently; it is now in discharged.md and "
            "cannot be raised again.")


def cmd_resolve(args):
    """A finding that generates work is closed by the work, not by time passing.
    Counting what closed is the only way to tell a draft that is being fixed from
    one that is only getting longer."""
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    findings = unit.get("findings") or []
    if not 0 <= args.index < len(findings):
        die(f"index out of range (0..{len(findings) - 1}). `nullius findings` lists "
            f"them.")
    f = findings[args.index]
    if f.get("resolved"):
        die(f"[{args.index}] is already closed: {f['resolution']}")
    f["resolved"] = now()
    f["resolution"] = args.what
    store.save_unit(unit)
    say(f"nullius: [{args.index}] {f['severity']} closed")


def cmd_findings(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    findings = unit.get("findings") or []
    if not findings:
        say("nullius: no findings in this unit.")
        return
    for i, f in enumerate(findings):
        mark = "closed " if f.get("resolved") else "open   "
        say(f"  [{i}] {mark} {f['severity']:<11} {f['referent']:<11} "
            f"{f['text'][:52]}")
        say(f"       at {f['at']}"
            + (f"  -- {f['resolution']}" if f.get("resolved") else ""))


def cmd_verdict(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    scale = venue_scale(store, unit)
    if args.recommendation not in scale:
        die(f"this unit's scale is: {', '.join(scale)}. It comes from the venue "
            f"file's Recommendation scale, so the vocabulary is the venue's rather "
            f"than ours.")
    unit["verdict"] = {"recommendation": args.recommendation, "when": now()}
    store.save_unit(unit)
    say(f"nullius: {args.recommendation}")


def cmd_kills(args):
    """The observation that would make you abandon the idea. An idea that has none is
    not an idea yet, and writing it down before the work is what stops it being
    rewritten afterwards to match whatever happened."""
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    unit["kills"] = args.text
    store.save_unit(unit)
    say("nullius: recorded. If that turns out to be true, the idea is over, and "
        "saying so now is what makes it a test rather than a hope.")


def cmd_cost(args):
    """Data, compute, access, approvals, calendar. The ideas that die late are the
    ones nobody priced early."""
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    unit["cost"] = args.text
    store.save_unit(unit)
    say("nullius: recorded.")


def cmd_trade(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    unit["trade"] = args.what
    store.save_unit(unit)
    say("nullius: trade recorded. The addition is now priced.")


def cmd_artifact(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    rel = os.path.relpath(Path(args.path).resolve(), store.root)
    if rel not in unit["artifacts"]:
        unit["artifacts"].append(rel)
    excluded = set(unit.get("excluded", []))
    if args.excluded:
        excluded.add(rel)
    else:
        excluded.discard(rel)
    unit["excluded"] = sorted(excluded)
    store.save_unit(unit)
    if args.excluded:
        say(f"nullius: tracking {rel}, outside the limit")
        say("  the walk searches it for required sections; the word budget does "
            "not count it. Say so in the venue file's Format block too, so the "
            "exclusion is the venue's rather than yours.")
    else:
        say(f"nullius: tracking {rel}")


def merge_records(primary, secondary):
    """Crossref is authoritative on metadata and retraction; OpenAlex is the only
    free route to author identifiers, which is what makes independence computable.
    Neither is privileged as a whole -- each contributes what it actually knows."""
    if primary and not secondary:
        return primary
    if secondary and not primary:
        return secondary
    out = dict(secondary)
    for k, v in primary.items():
        if v not in (None, "", [], False):
            out[k] = v
    if secondary.get("authors") and secondary.get("author_ids") != "name":
        out["authors"] = secondary["authors"]
        out.pop("author_ids", None)
    elif primary.get("authors"):
        out["authors"] = primary["authors"]
    out["retracted"] = bool(primary.get("retracted") or secondary.get("retracted"))
    out["index"] = "+".join(sorted({primary.get("index", ""),
                                    secondary.get("index", "")} - {""}))
    return out


def resolve_reference(cfg, identifier, first=False):
    """Reach the work by whatever route has it. Returns (record, note) where note
    is a line worth telling the user, or raises SystemExit through die()."""
    idx = cfg["indexes"]
    kind, value = normalise_identifier(identifier)
    arxiv_meta = None

    if kind == "arxiv":
        arxiv_meta = arxiv_lookup(value)
        if not arxiv_meta:
            die(f"arXiv has no record of '{value}'.")
        if arxiv_meta.get("doi"):
            kind, value = "doi", arxiv_meta["doi"].lower()
        else:
            kind, value = "title", arxiv_meta["title"]

    cross = oa = None
    if kind == "doi":
        if "crossref" in idx:
            cross = crossref_lookup(value, cfg["contact"])
        if "openalex" in idx:
            w = openalex(f"works/doi:{urllib.parse.quote(value, safe='')}",
                         cfg["contact"])
            oa = record_from_openalex(w) if w else None
        rec = merge_records(cross, oa)
        if rec:
            rec["matched_by"] = "doi"
    else:
        hits = []
        if "openalex" in idx:
            res = None
            try:
                res = openalex("works", cfg["contact"],
                               **{"filter": f"title.search:{filter_safe(value)}",
                                  "per-page": 5})
            except RuntimeError:
                pass
            if not (res or {}).get("results"):
                res = openalex("works", cfg["contact"], search=filter_safe(value),
                               **{"per-page": 5})
            hits = (res or {}).get("results") or []
        if arxiv_meta:
            want, year = norm_title(arxiv_meta["title"]), arxiv_meta.get("year")
            same = [h for h in hits
                    if norm_title(h.get("display_name")) == want
                    and (not year or not h.get("publication_year")
                         or abs(h["publication_year"] - year) <= YEAR_SLACK)]
            same.sort(key=lambda h: h.get("cited_by_count") or 0, reverse=True)
            rec = record_from_openalex(same[0]) if same else None
            if rec:
                rec["matched_by"] = "title+year"
        else:
            if len(hits) > 1 and not first:
                say("nullius: that title matches more than one work. Cite the one "
                    "you mean by its DOI:")
                for h in hits:
                    say(f"  {(h.get('doi') or '').replace('https://doi.org/', '') or '(no doi)':<34} "
                        f"{h.get('publication_year')}  {h.get('display_name', '')[:56]}")
                sys.exit(1)
            rec = record_from_openalex(hits[0]) if hits else None
            if rec:
                rec["matched_by"] = "title"

    note = None
    if not rec and arxiv_meta:
        rec = record_from_arxiv(arxiv_meta, normalise_identifier(identifier)[1])
        rec["matched_by"] = "arxiv-only"
        note = ("no index carries this beyond arXiv, so it is recorded as the "
                "preprint it is.")
    elif rec and arxiv_meta:
        rec["arxiv"] = normalise_identifier(identifier)[1]
        if not rec["authors"] and arxiv_meta["authors"]:
            rec["authors"] = [{"id": f"name:{slugify(n, 60)}", "name": n}
                              for n in arxiv_meta["authors"]]
            rec["author_ids"] = "name"
    if not rec:
        die(f"'{identifier}' did not resolve against {', '.join(idx)}. A "
            f"reference that cannot be resolved cannot be cited. If it is a "
            f"page, a book or a chapter rather than an indexed work, record it "
            f"as one:\n  nullius cite <url> --kind <"
            + "|".join(SOURCE_KINDS) + "> --title \"...\"")
    return rec, note


def cmd_cite(args):
    store = Store(require_root())
    cfg = store.config
    note = None

    if args.kind:
        if not args.title:
            die("a source the indexes do not carry needs --title. Its identity "
                "is the thing you are asserting, so it has to be written down.")
        rec = {
            "openalex": None, "doi": None, "url": args.identifier,
            "title": args.title, "year": args.year, "type": args.kind,
            "venue": args.venue or args.kind, "peer_reviewed": False,
            "retracted": False,
            "authors": [{"id": f"name:{slugify(a, 60)}", "name": a}
                        for a in (args.author or [])],
            "institutions": [], "cited_by": None, "oa_url": args.identifier,
            "referenced_works": [], "resolved_at": now(), "index": "manual",
            "author_ids": "name", "matched_by": "declared",
            "accessed": today(),
        }
        ceiling = STATUS_CEILING.get(args.kind)
        rec["status_ceiling"] = ceiling
        note = (f"a `{args.kind}` source. Nothing verified it for you, so it "
                f"carries what you saw on {today()} and no more"
                + (f", and it cannot support a status above `{ceiling}`."
                   if ceiling else "."))
    else:
        try:
            rec, note = resolve_reference(cfg, args.identifier, args.first)
        except RuntimeError as e:
            die(str(e))

    refs = store.refs
    existing = next((k for k, v in refs.items()
                     if (rec.get("openalex") and v.get("openalex") == rec["openalex"])
                     or (rec.get("doi") and v.get("doi") == rec["doi"])
                     or (rec.get("arxiv") and v.get("arxiv") == rec["arxiv"])
                     or (rec.get("url") and v.get("url") == rec["url"])), None)
    key = args.key or existing or make_citekey(rec, refs)
    refs[key] = rec
    store.save_refs(refs)

    say(f"nullius: {key}" + ("  RETRACTED" if rec["retracted"] else ""))
    say(f"  {rec['title'][:78]}")
    say(f"  {rec.get('venue') or '(no venue)'} · {rec.get('year')} · "
        f"{rec.get('type')} · {len(rec['authors'])} authors"
        + (f" · cited by {rec['cited_by']}" if rec.get("cited_by") else "")
        + f" · via {rec['index']}")
    if rec["retracted"]:
        say("  the index records this work as retracted. Citing it is a fact "
            "the gate will refuse.")
    if rec.get("matched_by") in ("title", "title+year"):
        say("  matched by title, not by identifier. Check it is the work you "
            "meant -- indexes carry duplicate records under one title.")
    if rec.get("author_ids") == "name":
        say("  authors carry no index identifier, so independence against this "
            "record is matched by name -- weaker, and defeated by a variant.")
    if rec.get("index") != "manual" and not rec.get("peer_reviewed"):
        say("  not peer reviewed. That travels with the claim.")
    if note:
        say(f"  {note}")


def pdf_to_text(url):
    """Opportunistic: poppler's pdftotext if the machine has it. Nothing here
    requires it, and a machine without it simply gets the URLs instead."""
    exe = shutil.which("pdftotext")
    if not exe:
        return None
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            blob = r.read()
    except Exception:
        return None
    if not blob.startswith(b"%PDF"):
        return None
    with tempfile.TemporaryDirectory() as d:
        f = Path(d) / "in.pdf"
        f.write_bytes(blob)
        try:
            out = subprocess.run([exe, "-q", str(f), "-"], capture_output=True,
                                 timeout=90)
        except Exception:
            return None
    text = out.stdout.decode("utf-8", "replace").strip()
    return text or None


ARXIV_URL_RE = re.compile(r"arxiv\.org/(?:abs|pdf)/(\d{4}\.\d{4,5})", re.I)


def cmd_fulltext(args):
    """Legal routes only, in the order most likely to have machine-readable text."""
    store = Store(require_root())
    cfg = store.config
    refs = store.refs
    rec = refs.get(args.citekey) or die(f"'{args.citekey}' is not resolved.")
    doi, urls = rec.get("doi"), []

    if doi:
        try:
            urls += unpaywall_locations(doi, cfg["contact"])
        except RuntimeError:
            pass
    if document_url(rec.get("oa_url")):
        urls.append(("index OA link", rec["oa_url"]))

    arxiv_id = rec.get("arxiv")
    if not arxiv_id:
        for _, u in urls:
            m = ARXIV_URL_RE.search(u)
            if m:
                arxiv_id = m.group(1)
                break
    if not arxiv_id and rec.get("title") and not doi:
        try:
            arxiv_id = arxiv_copy_of(rec["title"])
        except RuntimeError:
            arxiv_id = None
    if arxiv_id and arxiv_id != rec.get("arxiv"):
        rec["arxiv"] = arxiv_id
        refs[args.citekey] = rec
        store.save_refs(refs)
        say(f"nullius: a preprint copy exists -- arXiv:{arxiv_id}")
    if arxiv_id:
        urls = [("arXiv PDF", f"https://arxiv.org/pdf/{arxiv_id}"),
                ("arXiv abstract", f"https://arxiv.org/abs/{arxiv_id}")] + urls

    text, via = None, None
    if arxiv_id:
        try:
            html = http_text(f"https://arxiv.org/html/{arxiv_id}")
            if html and "<html" in html.lower():
                text, via = strip_html(html), f"arXiv HTML ({arxiv_id})"
        except RuntimeError:
            pass
    if not text and doi and "europepmc" in cfg["indexes"]:
        try:
            d = http_json("https://www.ebi.ac.uk/europepmc/webservices/rest/search?"
                          + urllib.parse.urlencode({"query": f"DOI:{doi}",
                                                    "format": "json",
                                                    "resultType": "core"}))
            res = ((d or {}).get("resultList") or {}).get("result") or []
            pmcid = next((r.get("pmcid") for r in res if r.get("pmcid")), None)
            if pmcid:
                urls.append(("Europe PMC",
                             f"https://europepmc.org/article/PMC/{pmcid}"))
                xml = http_text("https://www.ebi.ac.uk/europepmc/webservices/"
                                f"rest/{pmcid}/fullTextXML")
                if xml and "<" in xml:
                    text, via = strip_html(xml), f"Europe PMC ({pmcid})"
        except RuntimeError:
            pass
    if not text:
        for label, u in urls:
            got = pdf_to_text(u)
            if got and len(got.split()) > 500:
                text, via = got, f"pdftotext via {label}"
                break
    if doi:
        urls.append(("publisher", f"https://doi.org/{doi}"))

    if text:
        f = store.p("cache", "text", f"{args.citekey}.txt")
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(text, encoding="utf-8")
        say(f"nullius: {len(text.split())} words cached from {via}")
        say(f"  quotes can now be checked: nullius quote {args.citekey} \"<text>\"")
        say(f"  and the note can honestly go past `abstract` depth.")
        return

    say(f"nullius: no machine-readable full text for {args.citekey}.")
    seen_u = set()
    for label, u in urls:
        if u not in seen_u:
            seen_u.add(u)
            say(f"  {label:<24} {u}")
    if not shutil.which("pdftotext"):
        say("  install poppler (`brew install poppler`) and a PDF above becomes "
            "readable text; nothing here requires it.")
    say("  Other legal routes: your institution's proxy, the author's own copy "
        "or an email asking for one, and interlibrary loan.")
    say("  Until the text is here the note stays at `abstract` depth, which "
        "caps what may be claimed from it. That is the honest state, not a "
        "failure.")


def cmd_quote(args):
    store = Store(require_root())
    f = store.p("cache", "text", f"{args.citekey}.txt")
    if not f.is_file():
        die(f"no cached text for {args.citekey}. `nullius fulltext "
            f"{args.citekey}` -- and if it cannot be retrieved, the quote "
            f"cannot be checked and should not be presented as verbatim.")
    hay = re.sub(r"\s+", " ", f.read_text(encoding="utf-8")).lower()
    needle = re.sub(r"\s+", " ", args.text).strip().lower()
    if needle in hay:
        say(f"nullius: verbatim in {args.citekey}.")
        return
    say(f"nullius: NOT verbatim in the cached text of {args.citekey}.")
    words = needle.split()
    if len(words) > 4:
        head = " ".join(words[:4])
        i = hay.find(head)
        if i >= 0:
            say(f"  the opening matches; it diverges after. Cached nearby:")
            say(f"    ...{hay[i:i + len(needle) + 40]}...")
    sys.exit(2)


def cmd_note(args):
    store = Store(require_root())
    refs = store.refs
    if args.citekey not in refs:
        die(f"'{args.citekey}' is not resolved. `nullius cite` it first.")
    if args.depth not in READ_DEPTHS:
        die(f"depth must be one of: {', '.join(READ_DEPTHS)}")
    rec = refs[args.citekey]
    f = store.note_path(args.citekey)
    f.parent.mkdir(parents=True, exist_ok=True)
    if f.is_file():
        text = f.read_text(encoding="utf-8")
        text = re.sub(r"^read_depth:.*$", f"read_depth: {args.depth}", text,
                      count=1, flags=re.M)
        f.write_text(text, encoding="utf-8")
        say(f"nullius: {args.citekey} read_depth -> {args.depth}")
        return
    tpl = Path(__file__).resolve().parent.parent / "templates" / "paper-note.md"
    body = tpl.read_text(encoding="utf-8") if tpl.is_file() else \
        "read_depth: {depth}\n\n# {title}\n"
    fields = {
        "citekey": args.citekey, "depth": args.depth, "title": rec["title"],
        "year": rec.get("year"), "venue": rec.get("venue") or "",
        "doi": rec.get("doi") or "", "retracted": str(rec.get("retracted")).lower(),
        "peer_reviewed": str(rec.get("peer_reviewed")).lower(), "date": today(),
    }
    try:
        filled = body.format(**fields)
    except (KeyError, IndexError, ValueError):
        # templates/ is meant to be edited, and an edit may add a brace that
        # str.format cannot read. Substituting the known fields is better than
        # refusing to open a note.
        filled = body
        for k, v in fields.items():
            filled = filled.replace("{" + k + "}", str(v))
        say("  the template carries braces str.format could not read; the known "
            "fields were substituted and the rest left as written.")
    f.write_text(filled, encoding="utf-8")
    say(f"nullius: {os.path.relpath(f, store.root)} ({args.depth})")
    say("  the three mandatory fields are the point: the gap between claimed and "
        "evidenced, what it does not show, and what you still do not understand.")


def cmd_claim(args):
    store = Store(require_root())
    refs = store.refs
    if args.warrant not in WARRANTS:
        die(f"warrant must be one of: {', '.join(WARRANTS)}")
    if args.status not in STATUSES:
        die(f"status must be one of: {', '.join(STATUSES)}")
    if args.strength not in CLAIM_STRENGTHS:
        die(f"strength must be one of: {', '.join(CLAIM_STRENGTHS)}")
    if args.warrant == "assumed":
        die("there is no terminal `assumed` state. An assumption is an open "
            "question wearing another word, and the point is that you cannot "
            "finish inside one. Record it as a thread question instead.")

    sources = args.source or []
    if args.warrant != "mine-unpublished" and not sources:
        die("a claim needs at least one source. If it is your own unpublished "
            "data, say so: --warrant mine-unpublished.")
    for s in sources:
        if s not in refs:
            die(f"source '{s}' is not resolved. `nullius cite` it first.")
        if refs[s].get("retracted"):
            die(f"source '{s}' is recorded as retracted.")

    # read depth caps what the claim may assert
    for s in sources:
        depth = store.note_depth(s)
        if depth is None:
            die(f"no paper note for '{s}', so nothing records how far you read "
                f"it. `nullius note {s} --depth <{'|'.join(READ_DEPTHS)}>`.")
        if args.strength not in DEPTH_ALLOWS[depth]:
            die(f"'{s}' was read to depth `{depth}`, which supports "
                f"{', '.join(DEPTH_ALLOWS[depth])} -- not `{args.strength}`. "
                f"Read further, or make the weaker claim.")

    # a source kind the indexes do not carry caps how settled it can make a claim
    for src in sources:
        ceiling = refs[src].get("status_ceiling")
        if ceiling and STATUSES.index(args.status) > STATUSES.index(ceiling):
            die(f"'{src}' is a `{refs[src].get('type')}` source, which supports "
                f"`{ceiling}` at most, not `{args.status}`. It can still carry "
                f"the claim -- at what it is worth.")

    # independence caps how settled the claim may be called
    need = STATUS_NEEDS_GROUPS.get(args.status)
    if need:
        groups = author_groups(refs, sources)
        if groups < need:
            die(f"`{args.status}` needs {need} independent author groups; these "
                f"{len(sources)} source(s) form {groups}. Sharing an author is "
                f"not independent replication -- use `emerging` or "
                f"`single-result`, or add a group.")

    by_name = [x for x in sources if refs[x].get("author_ids") == "name"]
    claims = store.claims()
    claim = {
        "id": f"c{len(claims) + 1:03d}", "text": args.text,
        "warrant": args.warrant, "status": args.status,
        "strength": args.strength, "sources": sources,
        "locator": args.locator or "", "created": now(),
        "independence_by_name": by_name,
    }
    store.append_claim(claim)
    say(f"nullius: {claim['id']} recorded ({args.warrant} / {args.status} / "
        f"{args.strength})")
    if args.status in ("single-result", "folklore") or args.warrant == "authors-claim":
        say("  this may not be written as a bare assertion. Attribute and "
            "situate it in the prose.")
    if by_name and need:
        say(f"  independence here rests on name matching for "
            f"{', '.join(by_name)} -- two spellings of one person would read as "
            f"two groups. Weaker than it looks.")


def cmd_thread(args):
    """The unit that outlives a context window. Promised by the documentation and,
    until this existed, written by nothing."""
    store = Store(require_root())
    d = store.p("threads")
    d.mkdir(parents=True, exist_ok=True)
    if not args.slug:
        threads = sorted(d.glob("*.md"))
        if not threads:
            say("nullius: no threads yet. `nullius thread <slug>` opens one.")
            return
        for f in threads:
            head = f.read_text(encoding="utf-8")
            q = re.search(r"^## The question\s*\n+(.+)$", head, re.M)
            say(f"  {f.stem:<24} {(q.group(1).strip()[:52] if q else '(no question yet)')}")
        return
    f = d / f"{slugify(args.slug, 48)}.md"
    if f.is_file():
        say(f"nullius: {os.path.relpath(f, store.root)} already exists.")
        return
    tpl = Path(__file__).resolve().parent.parent / "templates" / "thread.md"
    body = tpl.read_text(encoding="utf-8") if tpl.is_file() else "# Thread\n"
    f.write_text(body.replace("<slug>", args.slug), encoding="utf-8")
    say(f"nullius: {os.path.relpath(f, store.root)}")
    say("  the current best answer carries its warrant and its status. Without "
        "those it is a note to self, and a note to self is what you already had.")


def cmd_falsify(args):
    store = Store(require_root())
    f = store.p("falsified.md")
    prev = f.read_text(encoding="utf-8") if f.is_file() else "# Falsified\n"
    f.write_text(prev.rstrip() + f"\n\n## {args.idea}\n\n- **killed by:** "
                 f"{args.why}\n- **when:** {today()}\n", encoding="utf-8")
    say("nullius: recorded. This is now injected before a write on that thread.")


def impact(rec):
    """Citations per year since publication. Raw counts rank a 2015 paper above a
    2026 one that matters more, which is the wrong ordering for a live search."""
    c, y = rec.get("cited_by"), rec.get("year")
    if c is None or not y:
        return None
    return c / max(1, datetime.now(timezone.utc).year - y + 1)


def cmd_lit(args):
    store = Store(require_root())
    cfg = store.config
    wanted = args.index or cfg["indexes"]
    hits, reached, failed, matched, route_note = [], [], [], {}, None

    if "openalex" in wanted:
        try:
            # Full-text search dilutes: the same intent matched 101,007 works through
            # `search` and 31 through title and abstract, and only the second set was
            # about the subject. Fall back to the loose route only if the tight one
            # returns almost nothing.
            res = openalex("works", cfg["contact"], **{
                "filter": f"title_and_abstract.search:{filter_safe(args.query)}",
                "per-page": args.limit})
            tight = len((res or {}).get("results") or [])
            if tight < 3 and args.loose:
                loose = openalex("works", cfg["contact"], search=args.query,
                                 **{"per-page": args.limit})
                if len((loose or {}).get("results") or []) > tight:
                    res = loose
                    route_note = ("--loose: matched over full text rather than "
                                  "title and abstract, which is much noisier")
            elif tight < 3:
                # An empty title-and-abstract result is information: the field does
                # not use these words. Substituting a full-text search returns
                # something and destroys the signal, so widening is opt-in.
                route_note = (f"only {tight} work(s) carry these terms in a title "
                              f"or abstract. That is a finding about the "
                              f"vocabulary rather than about the literature: try "
                              f"the words the field itself uses. `--loose` "
                              f"searches full text instead, and is much noisier.")
            for h in (res or {}).get("results") or []:
                hits.append({
                    "index": "openalex", "openalex": h.get("id"),
                    "title": h.get("display_name", ""),
                    "year": h.get("publication_year"),
                    "doi": (h.get("doi") or "").replace("https://doi.org/", "") or None,
                    "cited_by": h.get("cited_by_count"),
                    "venue": ((h.get("primary_location") or {}).get("source")
                              or {}).get("display_name"),
                    "oa": bool((h.get("open_access") or {}).get("is_oa")),
                    "relevance": h.get("relevance_score"),
                })
            matched["openalex"] = ((res or {}).get("meta") or {}).get("count")
            reached.append("openalex")
        except RuntimeError as e:
            failed.append(f"openalex ({e})")
    if "arxiv" in wanted:
        try:
            hits += arxiv_search(args.query, args.limit, counter=matched)
            reached.append("arxiv")
        except RuntimeError as e:
            failed.append(f"arxiv ({e})")
    if "europepmc" in wanted:
        try:
            hits += europepmc_search(args.query, args.limit, counter=matched)
            reached.append("europepmc")
        except RuntimeError as e:
            failed.append(f"europepmc ({e})")

    seen, merged = {}, []
    for h in hits:
        title_key = norm_title(h.get("title"))
        k = seen.get(title_key) is not None and title_key or (
            h.get("doi") or title_key)
        if title_key in seen:
            k = title_key
        if k in seen:
            prev = merged[seen[k]]
            if prev.get("cited_by") is None and h.get("cited_by") is not None:
                prev["cited_by"] = h["cited_by"]
            prev["index"] = "+".join(sorted({prev["index"], h["index"]}))
            prev["openalex"] = prev.get("openalex") or h.get("openalex")
            if h.get("arxiv"):
                prev["arxiv"] = h["arxiv"]
            continue
        seen[k] = len(merged)
        if title_key:
            seen[title_key] = len(merged)
        merged.append(dict(h, screened=None, reason=None))

    # arXiv and Europe PMC do not always carry a citation count, and a row with no
    # count cannot be ranked. One batched lookup fills them rather than N calls.
    blind = [r for r in merged if r.get("cited_by") is None and r.get("doi")]
    if blind and "openalex" in cfg["indexes"]:
        for chunk in [blind[i:i + 25] for i in range(0, len(blind), 25)]:
            try:
                res = openalex("works", cfg["contact"], **{
                    "filter": "doi:" + "|".join(r["doi"] for r in chunk),
                    "per-page": len(chunk)})
            except RuntimeError:
                break
            by_doi = {(w.get("doi") or "").replace("https://doi.org/", "").lower():
                      w for w in (res or {}).get("results") or []}
            for r in chunk:
                w = by_doi.get(r["doi"].lower())
                if w:
                    r["cited_by"] = w.get("cited_by_count")
                    r["openalex"] = r.get("openalex") or w.get("id")
                    r["index"] = "+".join(sorted({r["index"], "openalex"}))

    this_year = datetime.now(timezone.utc).year
    cutoff = this_year - cfg["recent_years"]
    ranked = sorted(merged, key=lambda r: (impact(r) is not None, impact(r) or 0),
                    reverse=True)
    recent = [r for r in ranked
              if (r.get("year") or 0) > cutoff and (r.get("cited_by") or 0)
              < cfg["rank_floor_citations"]]
    recent_ids = {id(r) for r in recent}
    body = [r for r in ranked if id(r) not in recent_ids]
    ordered = body + recent

    search = {
        # The label you chose is the handle you will look it up by, so it belongs in
        # the id: two queries in one vocabulary otherwise differ by a truncated slug.
        "id": f"{today()}-{slugify(args.vocabulary or 'q', 16)}"
              f"-{slugify(args.query, 24)}",
        "query": args.query,
        "vocabulary": args.vocabulary or slugify(args.query, 32),
        "indexes": reached, "unreachable": failed, "matched": matched,
        "when": now(), "matched_total": matched,
        "found": min([v for v in matched.values() if v] or [0]),
        "retrieved": len(ordered), "results": ordered,
    }
    store.save_search(search)

    loose_words = len(re.findall(r"[\w'-]{3,}", re.sub(r'"[^"]+"', " ", args.query)))
    if loose_words > 3 and '"' not in args.query:
        say(f"nullius: {loose_words} unquoted terms. The index ORs them, so the "
            f"result is whatever shares the commonest one. Quote the phrase the "
            f"field actually uses -- \"a phrase like this\" -- and it ANDs "
            f"instead.")
    per = ", ".join(f"{k} {v if v is not None else '?'}" for k, v in matched.items())
    say(f"nullius: retrieved {len(ordered)} distinct works. The indexes report "
        f"{per}"
        + (f"; unreachable: {', '.join(failed)}" if failed else "")
        + (f"\n  {route_note}" if route_note else ""))
    say(f"  relevance decides what is here, citations per year decide the order "
        f"within it. A count from an index that answered a loose query is not a "
        f"finding about the literature.")
    say(f"  ranked by citations per year -- raw counts would put a 2015 paper "
        f"above a 2026 one that matters more")
    for i, r in enumerate(ordered):
        if recent and r is recent[0]:
            say(f"  -- too new to rank on citations ({cutoff + 1}-{this_year}); "
                f"judge these on the abstract --")
        imp = impact(r)
        cite = "  n/a" if r.get("cited_by") is None else f"{r['cited_by']:>5}"
        per = "     " if imp is None else f"{imp:>5.0f}"
        say(f"  [{i}] {r.get('year') or '????'} {cite} {per}/yr  "
            f"{(r.get('title') or '')[:56]}")
        say(f"      {r.get('doi') or r.get('arxiv') or '(no id)'}  "
            f"{(r.get('venue') or '')[:44]}  via {r['index']}")
    say(f"  screen one: nullius screen {search['id']} "
        f"<include|exclude> \"<reason>\" --index N")
    say(f"  or in bulk:  nullius screen {search['id']} exclude "
        f"\"no citations yet, deprioritised\" --below-citations 1")


def snowball_state(store):
    return store.read_json("snowball.json", {})


def openalex_short(wid):
    return (wid or "").rsplit("/", 1)[-1]


def walk_one(cfg, wid, directions, limit, seed_title, doi, want_context):
    """One hop from one seed. Returns (rows, counts)."""
    rows, counts = [], {}
    for name, filt in directions:
        try:
            res = openalex("works", cfg["contact"], **{
                "filter": f"{filt}:{wid}", "sort": "cited_by_count:desc",
                "per-page": limit})
        except RuntimeError as e:
            counts[name] = None
            rows.append({"_error": f"{name}: {e}"})
            continue
        hits = (res or {}).get("results") or []
        counts[name] = ((res or {}).get("meta") or {}).get("count", len(hits))
        influential = {}
        if name == "forward" and doi and want_context:
            influential = s2_influential(doi, limit)
        for h in hits:
            hdoi = (h.get("doi") or "").replace("https://doi.org/", "").lower()
            extra = influential.get(hdoi, {})
            rows.append({
                "index": "openalex", "title": h.get("display_name", ""),
                "year": h.get("publication_year"), "doi": hdoi or None,
                "openalex": h.get("id"), "cited_by": h.get("cited_by_count"),
                "venue": ((h.get("primary_location") or {}).get("source")
                          or {}).get("display_name"),
                "via": f"{name} from {seed_title[:40]}",
                "influential": extra.get("influential"),
                "context": extra.get("context"),
                "screened": None, "reason": None})
    return rows, counts


def cmd_snowball(args):
    """The citation graph, both directions and to depth. A keyword search finds what
    shares your words. The graph finds what the field linked, and the works many of
    your seeds point at are the ones a query will never reliably surface."""
    store = Store(require_root())
    cfg = store.config
    state = snowball_state(store)
    refs = store.refs

    seeds = []
    if args.citekey:
        rec = refs.get(args.citekey) or die(f"'{args.citekey}' is not resolved.")
        if not rec.get("openalex"):
            die(f"'{args.citekey}' has no index record to walk from. The citation "
                f"graph is OpenAlex's; a manually recorded source has no place in it.")
        seeds.append((openalex_short(rec["openalex"]), rec["title"],
                      rec.get("doi"), rec.get("year")))
    else:
        for sr in store.searches():
            for r in sr.get("results", []):
                if r.get("screened") != "include" or not r.get("openalex"):
                    continue
                wid = openalex_short(r["openalex"])
                if wid in state or any(wid == x[0] for x in seeds):
                    continue
                seeds.append((wid, r.get("title", ""), r.get("doi"),
                              r.get("year")))
        seeds = seeds[:args.seeds or cfg["snowball_seeds"]]
    if not seeds:
        say("nullius: nothing to walk from. Screen something in first -- the seed "
            "set is what you decided was close, not what a query returned.")
        return

    limit = args.limit or cfg["snowball_limit"]
    depth = args.depth or cfg["snowball_depth"]
    directions = ([("back", "cited_by"), ("forward", "cites")]
                  if args.both or not (args.back or args.forward)
                  else ([("back", "cited_by")] if args.back else []) +
                       ([("forward", "cites")] if args.forward else []))

    seed_years = sorted(y for _, _, _, y in seeds if y)
    era = seed_years[len(seed_years) // 2] if seed_years else None
    oldest_seed = seed_years[0] if seed_years else None
    reached, all_rows = {}, []
    frontier = list(seeds)
    for hop in range(1, depth + 1):
        say(f"hop {hop}: {len(frontier)} seed(s)")
        hop_rows, seen_before, new_here = [], 0, 0
        for wid, title, doi, _sy in frontier:
            rows, counts = walk_one(cfg, wid, directions, limit, title, doi,
                                    not args.no_context)
            for r in rows:
                if r.get("_error"):
                    say(f"  {r['_error']}")
                    continue
                key = openalex_short(r["openalex"])
                if key in reached:
                    seen_before += 1
                else:
                    new_here += 1
                    reached[key] = dict(r, by=[], hop=hop)
                if wid not in reached[key]["by"]:
                    reached[key]["by"].append(wid)
                hop_rows.append(r)
            state[wid] = {"title": title, "when": now(), "hop": hop,
                          "back": counts.get("back"),
                          "forward": counts.get("forward"),
                          "capped": any((counts.get(k) or 0) > limit
                                        for k in counts)}
        all_rows += hop_rows
        total = new_here + seen_before
        sat = (seen_before / total * 100) if total else 0
        say(f"  {new_here} new, {seen_before} already reached"
            + (f", {sat:.0f}% of this hop was known" if total else ""))
        if hop >= depth:
            break
        # Follow what the field points at repeatedly, not everything: the next
        # seeds are the works most of this hop's seeds already agree on.
        # Not by citation count. A work reached by three seeds with ten thousand
        # citations and a 1962 date is an ancestor of everything, not this field's
        # shared reference, and letting it lead the next hop walks the search into
        # a different literature. Multiplicity first, then nearness to the seeds' era.
        def frontier_key(r):
            gap = abs((r.get("year") or era or 0) - era) if era else 0
            return (len(r["by"]), -gap)

        ranked = sorted(reached.values(), key=frontier_key, reverse=True)
        frontier = [(openalex_short(r["openalex"]), r["title"], r.get("doi"),
                     r.get("year"))
                    for r in ranked
                    if openalex_short(r["openalex"]) not in state][
                        :args.seeds or cfg["snowball_seeds"]]
        if not frontier:
            say("  nothing new to walk from; the graph closed here")
            break

    store.write_json("snowball.json", state)
    if not all_rows:
        return
    search = {
        # Naming a multi-seed walk after whichever seed happened to be first says
        # something false about what was walked.
        "id": f"{today()}-snowball-d{depth}-{len(seeds)}seeds",
        "query": (f"snowball from {seeds[0][1]}" if len(seeds) == 1
                  else f"snowball from {len(seeds)} seeds, depth {depth}"),
        "vocabulary": "snowball", "indexes": ["openalex"], "unreachable": [],
        "matched_total": {}, "when": now(), "found": len(reached),
        "retrieved": len(reached), "depth": depth,
        "seeds": len(seeds), "era": era,
        "results": [dict({k: v for k, v in r.items() if k != "by"},
                         seeds_reaching=len(r["by"]))
                    for r in sorted(reached.values(),
                                    key=lambda r: (len(r["by"]),
                                                   r.get("cited_by") or 0),
                                    reverse=True)]}
    store.save_search(search)

    shared = [r for r in search["results"] if r["seeds_reaching"] > 1]
    gap = cfg["snowball_ancestor_gap"]
    if shared:
        say("")
        say(f"reached from more than one of {len(seeds)} seeds, which no query "
            f"would have told you:")
        for r in shared[:12]:
            share = r["seeds_reaching"] / max(1, len(seeds))
            old = (oldest_seed and r.get("year")
                   and r["year"] < oldest_seed - gap)
            note = "  ancestor?" if old else ""
            say(f"  {r['seeds_reaching']}/{len(seeds)} ({share:.0%})  {r['year']} "
                f"{str(r['cited_by']):>6}  {(r['title'] or '')[:46]}{note}")
        if any(r.get("year") and oldest_seed and r["year"] < oldest_seed - gap
               for r in shared[:12]):
            say(f"  `ancestor?` marks a work more than {gap} years older than your "
                f"oldest seed. Reached by several seeds it is often an ancestor of "
                f"everything nearby rather than this field's own reference, and it "
                f"is a lead rather than a verdict.")
        say("  A work several of your seeds point at is what the field agrees is "
            "behind them. Read the share, not the count: two of thirteen is noise, "
            "and two of three is agreement.")
    else:
        say("")
        say("nothing was reached from more than one seed. Either the seed set is "
            "too small to triangulate, or these works do not share a literature, "
            "and the second would be the more interesting finding.")
    say(f"  logged as {search['id']}; screen it like any other search")


def cmd_screen(args):
    store = Store(require_root())
    f = store.p("searches", f"{args.search}.json")
    if not f.is_file():
        die(f"no search '{args.search}'.")
    search = json.loads(f.read_text(encoding="utf-8"))
    rows = search["results"]

    if args.below_citations is not None or args.all_remaining:
        # One recorded rule beats forty individual judgements, and it is the more
        # reproducible of the two: the next reader can see what was applied.
        touched, unknown = 0, 0
        for r in rows:
            if r["screened"] is not None:
                continue
            if args.all_remaining:
                hit = True
            elif r.get("cited_by") is None:
                # An index that does not report a count has not reported zero. Sweeping
                # these away drops exactly the preprints the count could not be found for.
                unknown += 1
                continue
            else:
                hit = r["cited_by"] < args.below_citations
            if hit:
                r["screened"] = args.decision
                r["reason"] = args.reason
                r["by_rule"] = ("all-remaining" if args.all_remaining
                                else f"cited_by<{args.below_citations}")
                touched += 1
        search.setdefault("rules", []).append({
            "rule": ("all-remaining" if args.all_remaining
                     else f"cited_by<{args.below_citations}"),
            "decision": args.decision, "reason": args.reason,
            "applied_to": touched, "when": now()})
        store.save_search(search)
        left = sum(1 for r in rows if r["screened"] is None)
        say(f"nullius: {args.decision}d {touched} by rule. {left} unscreened.")
        if unknown:
            say(f"  {unknown} left alone: no index reported a citation count for "
                f"them, and unknown is not zero. Judge those on the abstract.")
        if args.decision == "exclude" and args.below_citations:
            say("  recorded as a rule, so it is one exclusion criterion rather "
                "than forty judgements -- and a reader can disagree with it "
                "in one place.")
        return

    if args.index is None:
        die("give an index, or a bulk rule: --below-citations N, --all-remaining.")
    if not 0 <= args.index < len(rows):
        die(f"index out of range (0..{len(rows) - 1}).")
    rows[args.index]["screened"] = args.decision
    rows[args.index]["reason"] = args.reason
    store.save_search(search)
    left = sum(1 for r in rows if r["screened"] is None)
    say(f"nullius: [{args.index}] {args.decision}. {left} unscreened in this search.")


def cmd_coverage(args):
    store = Store(require_root())
    cfg = store.config
    searches = store.searches()
    if not searches:
        say("nullius: no searches logged yet. `nullius lit \"<query>\"`.")
        return
    per_index = {}
    for sr in searches:
        for k, v in (sr.get("matched_total") or {}).items():
            if v:
                per_index[k] = max(per_index.get(k, 0), v)
    results = [r for s in searches for r in s.get("results", [])]
    screened = sum(1 for r in results if r["screened"] is not None)
    included = sum(1 for r in results if r["screened"] == "include")
    vocabs = {s.get("vocabulary") for s in searches if s.get("vocabulary")}
    years = [r["year"] for r in results if r.get("year")]
    refs = store.refs
    groups = author_groups(refs, list(refs.keys()))
    want = cfg["vocabularies_suggested"]

    say("matched      " + (", ".join(f"{k} {v}" for k, v in sorted(per_index.items()))
                            or "not recorded"))
    say(f"retrieved    {len(results):<6} screened {screened:<5} included {included}"
        f"  unscreened {len(results) - screened}")
    say(f"vocabularies {len(vocabs):<6} of {want} suggested"
        + ("" if len(vocabs) >= want else
           "  -- try the field's terms, not yours"))
    say(f"groups       {groups:<6} across {len(refs)} resolved reference(s)"
        + ("" if groups > 1 or len(refs) < 2 else
           "  -- shared authors, not independent"))
    if years:
        say(f"years        {min(years)}-{max(years)}")
    unscreened = [(s["id"], i, r) for s in searches
                  for i, r in enumerate(s.get("results", []))
                  if r["screened"] is None]
    if unscreened:
        say("")
        say("unscreened:")
        for sid, i, r in unscreened[:20]:
            say(f"  {sid} [{i}]  {r['year']}  {(r['title'] or '')[:58]}")
        if len(unscreened) > 20:
            say(f"  ... and {len(unscreened) - 20} more")


def cmd_check(args):
    store = Store(require_root())
    path = Path(args.path).resolve()
    if not path.is_file():
        die(f"{args.path} is not a file.")
    text = path.read_text(encoding="utf-8", errors="replace")
    rel = os.path.relpath(path, store.root)
    facts = check_draft_text(store, text, rel)
    chosen = check_attribution(store, text, rel)
    words = count_words(text)
    cfg = store.config
    say(f"{rel}: {words} words, {len(cited_keys(text, cfg))} citation key(s), "
        f"{len(bare_identifiers(text, cfg))} bare identifier(s), "
        f"{len(attributed_names(text, cfg))} attributed name(s)")
    for f in facts:
        say(f"  FACT   {f}")
    for c in chosen:
        say(f"  chosen {c}")
    if not facts and not chosen:
        say("  clean.")
    sys.exit(2 if facts else 0)


def cmd_status(args):
    store = Store(require_root())
    unit = store.unit
    refs, claims = store.refs, store.claims()
    say(f"project   {store.root}")
    say(f"field     {store.config.get('field') or '(unset -- .nullius/field.md)'}")
    say(f"ledger    {len(refs)} reference(s), {len(claims)} claim(s)")
    if not unit:
        say("unit      none open. Nothing about the current work is being "
            "checked.")
        return
    say(f"unit      {unit['slug']} ({unit['kind']})"
        + (f" -> {unit['venue']}" if unit.get("venue") else ""))
    say(f"question  {unit['question']}")
    say(f"accept    {unit.get('accept') or '(not declared)'}"
        + ("  [closed]" if unit.get("accept_closed") else ""))
    budget, source = effective_budget(store, unit, store.config)
    if budget:
        words = sum(count_words(f.read_text(encoding='utf-8', errors='replace'))
                    for f in tracked_drafts(store, unit, counted_only=True))
        say(f"budget    {words} / {budget} words  ({source})")
    facts, chosen = unit_findings(store)
    say("")
    if facts:
        say("the stop gate refuses on these facts:")
        for f in facts:
            say(f"  - {f}")
    if chosen:
        say("reported, and marked as chosen rather than measured:")
        for c in chosen:
            say(f"  - {c}")
    if not facts and not chosen:
        say("finishable.")


def cmd_done(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    facts, _ = unit_findings(store)
    if facts and not args.force:
        say("nullius: not finishable yet --")
        for f in facts:
            say(f"  - {f}")
        sys.exit(1)
    log = store.p("work", "log.jsonl")
    log.parent.mkdir(parents=True, exist_ok=True)
    unit["finished"] = now()
    with log.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(unit, ensure_ascii=False) + "\n")
    store.clear_unit()
    say(f"nullius: '{unit['slug']}' closed.")


def cmd_doctor(args):
    store_root = find_root()
    ok = True
    say(f"python    {sys.version.split()[0]}")
    if sys.version_info < (3, 8):
        say("  FAIL nullius needs Python 3.8 or newer.")
        ok = False
    if store_root is None:
        say("project   none found from here. `nullius init`.")
        return sys.exit(1)
    store = Store(store_root)
    cfg = store.config
    say(f"project   {store_root}")
    say(f"mode      {cfg['mode']}")
    say(f"contact   {cfg['contact'] or '(unset)'}"
        + ("" if cfg["contact"] else
           "  -- Unpaywall returns 422 without one, so `fulltext` cannot find "
           "preprint copies"))
    for d in ("papers", "searches", "venues", "threads"):
        n = len(list(store.p(d).glob("*"))) if store.p(d).is_dir() else 0
        say(f"{d:<9} {n}")
    refs = store.refs
    retracted = [k for k, v in refs.items() if v.get("retracted")]
    if retracted:
        say(f"  retracted references present: {', '.join(retracted)}")
        ok = False
    orphan = [c["id"] for c in store.claims()
              for s in c.get("sources", []) if s not in refs]
    if orphan:
        say(f"  claims citing unresolved sources: {', '.join(sorted(set(orphan)))}")
        ok = False
    for k in refs:
        if store.note_depth(k) is None:
            say(f"  no paper note for {k}, so claims from it are capped at nothing")
    try:
        openalex("works", cfg["contact"], search="test", **{"per-page": 1})
        say("openalex  reachable")
    except RuntimeError as e:
        say(f"openalex  UNREACHABLE ({e}). Local gates still work; `cite` and "
            f"`lit` will not.")
    sys.exit(0 if ok else 1)


# -------------------------------------------------------------------- hooks
# Hooks read local state only. A hook that makes a network call hangs the session,
# so resolution happens in `cite`, deliberately, and the gates check what it wrote.


def hook_payload():
    try:
        return json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        return {}


def hook_session_start(payload):
    root = find_root(payload.get("cwd"))
    if root is None:
        return 0
    store = Store(root)
    plugin = Path(__file__).resolve().parent.parent
    parts = []
    inv = plugin / "invariants"
    if inv.is_dir():
        for f in sorted(inv.glob("*.md")):
            parts.append(f.read_text(encoding="utf-8").rstrip())
    unit = store.unit
    cfg = store.config
    lines = []
    if unit:
        lines.append(f"Open unit: {unit['slug']} ({unit['kind']}) -- "
                     f"{unit['question']}")
        lines.append(f"  accept: {unit.get('accept') or 'NOT DECLARED'}")
        if unit.get("accept_answer"):
            lines.append(f"  answered: {unit['accept_answer']}")
        # These two are the decisions an idea rests on. Losing them at a context
        # boundary is how an idea gets quietly rewritten to match what happened.
        if unit.get("kills"):
            lines.append(f"  what would end it: {unit['kills']}")
        if unit.get("cost"):
            lines.append(f"  what it takes: {unit['cost']}")
        if unit.get("venue"):
            budget, source = effective_budget(store, unit, cfg)
            drafts = tracked_drafts(store, unit, counted_only=True)
            words = sum(count_words(f.read_text(encoding="utf-8", errors="replace"))
                        for f in drafts)
            lines.append(f"  venue {unit['venue']}"
                         + (f", {words}/{budget} words" if budget else ""))
        for name, d in section_dispositions(store, unit.get("venue")).items():
            lines.append(f"  section '{name}': {d['as']}, {d['why']}")
        if unit.get("kind") in ("critique", "referee", "write"):
            sc = artifact_scope(store, unit)
            if sc and sc["rows"]:
                lines.append(f"The draft rules these out by decision "
                             f"({sc['file']}:{sc['line']}); a suggestion matching "
                             f"one is not a gap:")
                for r in sc["rows"][:8]:
                    lines.append(f"  out: {r['item'][:70]}")
        if unit.get("trade"):
            lines.append(f"  trade taken: {unit['trade']}")
        facts, chosen = unit_findings(store)
        for f in facts:
            lines.append(f"  fact:   {f}")
        for c in chosen:
            lines.append(f"  chosen: {c}")
    else:
        lines.append("No unit is open, so nothing about the current work is "
                     "being checked. For anything past reading one paper: "
                     "`nullius start <slug> <kind> \"<question>\"`.")

    searches = store.searches()
    if searches:
        results = [r for sr in searches for r in sr.get("results", [])]
        inc = sum(1 for r in results if r.get("screened") == "include")
        un = sum(1 for r in results if r.get("screened") is None)
        vocabs = {sr.get("vocabulary") for sr in searches if sr.get("vocabulary")}
        lines.append(f"Searches: {len(searches)} across {len(vocabs)} vocabular"
                     f"{'y' if len(vocabs) == 1 else 'ies'}, {len(results)} "
                     f"retrieved, {inc} included, {un} unscreened.")
        for sr in searches:
            kept = [r for r in sr.get("results", []) if r.get("screened") == "include"]
            for r in kept[:4]:
                lines.append(f"  kept: {(r.get('title') or '')[:64]}"
                             + (f" -- {r.get('reason')}" if r.get("reason") else ""))
    refs = store.refs
    lines.append(f"Ledger: {len(refs)} reference(s), {len(store.claims())} claim(s).")
    tdir = store.p("threads")
    if tdir.is_dir():
        names = sorted(f.stem for f in tdir.glob("*.md"))
        if names:
            lines.append(f"Threads open: {', '.join(names[:10])}"
                         + (f" (+{len(names) - 10} more)" if len(names) > 10 else ""))
    fals = store.p("falsified.md")
    if fals.is_file():
        killed = re.findall(r"^## (.+)$", fals.read_text(encoding="utf-8"), re.M)
        if killed:
            lines.append("Already falsified, do not re-propose: "
                         + "; ".join(killed[:8]))
    parts.append("## nullius: this project right now\n\n" + "\n".join(lines))
    parts.append(VOCABULARY)
    sys.stdout.write("\n\n".join(parts) + "\n")
    return 0


def hook_pre_write(payload):
    root = find_root(payload.get("cwd"))
    if root is None:
        return 0
    store = Store(root)
    cfg = store.config
    ti = payload.get("tool_input") or {}
    target = ti.get("file_path") or ""
    if not target or not is_draft(target, cfg):
        return 0
    text = ti.get("content") or ti.get("new_string") or ""
    if not text:
        return 0
    rel = os.path.relpath(Path(target).resolve(), store.root) \
        if Path(target).is_absolute() else target
    facts = check_draft_text(store, text, rel)
    if facts and cfg["mode"] in ("certain", "block"):
        sys.stderr.write("nullius refuses this write:\n  - "
                         + "\n  - ".join(facts) + "\n")
        return 2
    notes = []
    known_names = resolved_surnames(refs)
    for name in sorted(attributed_names(text, cfg)):
        low = fold_name(name)
        if low in known_names or any(low in n.split() for n in known_names):
            continue
        facts.append(f"{label}: the text attributes something to `{name}` and no "
                     f"resolved reference has an author of that name. A name is a "
                     f"citation -- it is how most prose actually cites -- and it "
                     f"is the form nothing else checks. `nullius cite` the work, "
                     f"or drop the attribution.")
    for key in sorted(cited_keys(text, cfg)):
        depth = store.note_depth(key)
        if depth:
            notes.append(f"{key}: read to `{depth}`")
    if notes:
        emit_context("nullius: read depth of what this cites -- "
                     + "; ".join(notes) + ". A claim may not exceed it.")
    return 0


def emit_context(text):
    sys.stdout.write(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "additionalContext": text}}) + "\n")


def hook_stop(payload):
    root = find_root(payload.get("cwd"))
    if root is None:
        return 0
    store = Store(root)
    if store.unit is None:
        return 0
    sample_growth(store)
    facts, chosen = unit_findings(store)
    mode = store.config["mode"]
    if facts and mode in ("certain", "block"):
        sys.stderr.write(
            f"nullius: unit '{store.unit['slug']}' is not finishable yet.\n  - "
            + "\n  - ".join(facts)
            + (("\n  and, on thresholds that were chosen rather than measured:"
                "\n  - " + "\n  - ".join(chosen)) if chosen else "")
            + "\n")
        return 2
    if chosen and mode == "block":
        sys.stderr.write("nullius: only chosen thresholds remain:\n  - "
                         + "\n  - ".join(chosen) + "\n")
        return 2
    if chosen:
        # A threshold picked rather than measured does not get to end a turn. It goes
        # to the person, who can judge it, through the one channel Stop has for them.
        sys.stdout.write(json.dumps({"systemMessage": (
            f"nullius: '{store.unit['slug']}' is finishable on the facts. These rest "
            f"on thresholds that were chosen rather than measured, so they are "
            f"reported rather than enforced:\n  - " + "\n  - ".join(chosen))}) + "\n")
    return 0


def cmd_hook(args):
    payload = hook_payload()
    fn = {"session-start": hook_session_start, "pre-write": hook_pre_write,
          "stop": hook_stop}.get(args.event)
    if fn is None:
        return 0
    try:
        sys.exit(fn(payload))
    except SystemExit:
        raise
    except Exception as e:  # a broken gate must never wedge a session
        sys.stderr.write(f"nullius: gate error ({type(e).__name__}: {e})\n")
        sys.exit(0)


# --------------------------------------------------------------------- main


def build_parser():
    p = argparse.ArgumentParser(prog="nullius",
                                description="take nobody's word for it")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init", help="scaffold .nullius/ here")
    s.add_argument("path", nargs="?")
    s.add_argument("--field"); s.add_argument("--email")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("config", help="read or set a config key")
    s.add_argument("key", nargs="?"); s.add_argument("value", nargs="?")
    s.add_argument("--user", action="store_true",
                   help="write to ~/.config/nullius/config.json instead of the "
                        "project. `contact` always goes here.")
    s.set_defaults(fn=cmd_config)

    s = sub.add_parser("start", help="open a work unit")
    s.add_argument("slug"); s.add_argument("kind", choices=UNIT_KINDS)
    s.add_argument("question")
    s.add_argument("--venue"); s.add_argument("--words", type=int)
    s.add_argument("--artifact", action="append")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("accept", help="declare what would close this unit")
    s.add_argument("question"); s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_accept)

    s = sub.add_parser("close", help="answer the acceptance question")
    s.add_argument("answer"); s.set_defaults(fn=cmd_close)

    s = sub.add_parser("decisive", help="the number that would change the conclusion")
    s.add_argument("text")
    s.add_argument("--post-hoc", action="store_true", dest="post_hoc",
                   help="named after the results; exploratory, and labelled as such")
    s.set_defaults(fn=cmd_decisive)

    s = sub.add_parser("reading", help="what was actually observed")
    s.add_argument("text"); s.set_defaults(fn=cmd_reading)

    s = sub.add_parser("finding", help="one finding, with a referent and a locator")
    s.add_argument("severity", choices=SEVERITIES)
    s.add_argument("referent")
    s.add_argument("text")
    s.add_argument("--at", required=True, help="where: file:line, a section, a table")
    s.set_defaults(fn=cmd_finding)

    s = sub.add_parser("findings", help="what this unit has found so far")
    s.set_defaults(fn=cmd_findings)

    s = sub.add_parser("resolve", help="close a finding, with what changed")
    s.add_argument("index", type=int); s.add_argument("what")
    s.set_defaults(fn=cmd_resolve)

    s = sub.add_parser("verdict", help="the recommendation this critique adds up to")
    s.add_argument("recommendation"); s.set_defaults(fn=cmd_verdict)

    s = sub.add_parser("kills", help="the observation that would end this idea")
    s.add_argument("text"); s.set_defaults(fn=cmd_kills)

    s = sub.add_parser("cost", help="what this idea would take to run")
    s.add_argument("text"); s.set_defaults(fn=cmd_cost)

    s = sub.add_parser("trade", help="price an addition made over budget")
    s.add_argument("what"); s.set_defaults(fn=cmd_trade)

    s = sub.add_parser("artifact", help="track a draft against this unit")
    s.add_argument("path")
    s.add_argument("--excluded", action="store_true",
                   help="searched by the walk, not counted toward the limit "
                        "(a supplement, an appendix the venue excludes)")
    s.set_defaults(fn=cmd_artifact)

    s = sub.add_parser("cite", help="resolve an identifier, or record a source "
                                     "no index carries")
    s.add_argument("identifier", help="DOI, arXiv id, title, or a URL with --kind")
    s.add_argument("--key"); s.add_argument("--first", action="store_true")
    s.add_argument("--kind", choices=SOURCE_KINDS,
                   help="for a page, book, chapter, thesis, dataset or talk")
    s.add_argument("--title"); s.add_argument("--venue")
    s.add_argument("--year", type=int)
    s.add_argument("--author", action="append")
    s.set_defaults(fn=cmd_cite)

    s = sub.add_parser("fulltext", help="find a legal full text, and cache it")
    s.add_argument("citekey"); s.set_defaults(fn=cmd_fulltext)

    s = sub.add_parser("quote", help="check a quote verbatim against cached text")
    s.add_argument("citekey"); s.add_argument("text")
    s.set_defaults(fn=cmd_quote)

    s = sub.add_parser("note", help="open a paper note at a read depth")
    s.add_argument("citekey")
    s.add_argument("--depth", required=True, choices=READ_DEPTHS)
    s.set_defaults(fn=cmd_note)

    s = sub.add_parser("claim", help="record a claim with its warrant and status")
    s.add_argument("text")
    s.add_argument("--warrant", required=True, choices=WARRANTS)
    s.add_argument("--status", required=True, choices=STATUSES)
    s.add_argument("--strength", default="reports", choices=CLAIM_STRENGTHS)
    s.add_argument("--source", action="append"); s.add_argument("--locator")
    s.set_defaults(fn=cmd_claim)

    s = sub.add_parser("thread", help="open or list a research thread")
    s.add_argument("slug", nargs="?"); s.set_defaults(fn=cmd_thread)

    s = sub.add_parser("falsify", help="record an idea that died, and why")
    s.add_argument("idea"); s.add_argument("why"); s.set_defaults(fn=cmd_falsify)

    s = sub.add_parser("lit", help="search the indexes and log the protocol")
    s.add_argument("query"); s.add_argument("--vocabulary")
    s.add_argument("--limit", type=int, default=10)
    s.add_argument("--loose", action="store_true",
                   help="match over full text when title and abstract is thin")
    s.add_argument("--index", action="append",
                   choices=["openalex", "arxiv", "europepmc"],
                   help="default: whatever .nullius/config.json lists")
    s.set_defaults(fn=cmd_lit)

    s = sub.add_parser("snowball", help="walk the citation graph from what you kept")
    s.add_argument("citekey", nargs="?")
    s.add_argument("--back", action="store_true", help="what the seed cites")
    s.add_argument("--forward", action="store_true", help="what cites the seed")
    s.add_argument("--both", action="store_true")
    s.add_argument("--limit", type=int); s.add_argument("--seeds", type=int)
    s.add_argument("--depth", type=int,
                   help="how many hops; each hop follows the works most seeds agree on")
    s.add_argument("--no-context", action="store_true", dest="no_context",
                   help="skip the Semantic Scholar lookup")
    s.set_defaults(fn=cmd_snowball)

    s = sub.add_parser("screen", help="include or exclude retrieved works")
    s.add_argument("search")
    s.add_argument("decision", choices=["include", "exclude"])
    s.add_argument("reason")
    s.add_argument("--index", type=int)
    s.add_argument("--below-citations", type=int, dest="below_citations",
                   help="apply to everything unscreened under this many citations")
    s.add_argument("--all-remaining", action="store_true", dest="all_remaining")
    s.set_defaults(fn=cmd_screen)

    s = sub.add_parser("walk", help="every required section, present/thin/absent")
    s.add_argument("--venue"); s.set_defaults(fn=cmd_walk)

    s = sub.add_parser("scope", help="what the draft itself rules out, and why")
    s.set_defaults(fn=cmd_scope)

    s = sub.add_parser("section", help="say what an absent required section is")
    s.add_argument("name")
    s.add_argument("disposition", choices=SECTION_DISPOSITIONS)
    s.add_argument("why", nargs="?"); s.set_defaults(fn=cmd_section)

    s = sub.add_parser("coverage", help="the counts, and what is unscreened")
    s.set_defaults(fn=cmd_coverage)

    s = sub.add_parser("check", help="run the write guards over a draft")
    s.add_argument("path"); s.set_defaults(fn=cmd_check)

    s = sub.add_parser("status", help="why the stop gate is refusing")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("done", help="close the unit")
    s.add_argument("--force", action="store_true"); s.set_defaults(fn=cmd_done)

    s = sub.add_parser("doctor", help="is this project still set up correctly")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("_hook", help=argparse.SUPPRESS)
    s.add_argument("event"); s.set_defaults(fn=cmd_hook)
    return p


def main():
    args = build_parser().parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
