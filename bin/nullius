#!/usr/bin/env python3
"""nullius -- take nobody's word for it.

The ledger and the gates. Python 3 standard library only: a researcher should be
able to add this to Claude Code without installing anything first.
"""

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import unicodedata
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

STATE_DIR = ".nullius"
API_TIMEOUT = 20
# How far an indexed record's year may sit from the preprint's before it is a
# different work rather than the same one.
YEAR_SLACK = 2

READ_DEPTHS = ["abstract", "skim", "method", "replicated"]

# What a claim is allowed to assert, indexed by how far its source was read.
CLAIM_STRENGTHS = ["reports", "holds", "mechanism", "generalises"]
DEPTH_ALLOWS = {
    "abstract": ["reports"],
    "skim": ["reports", "holds"],
    "method": ["reports", "holds", "mechanism"],
    "replicated": ["reports", "holds", "mechanism", "generalises"],
}

WARRANTS = ["measured", "authors-claim", "replicated", "consensus",
            "inferred", "mine-unpublished", "assumed"]

# Ordered weakest to strongest. Independence caps how far up this a claim may go.
STATUSES = ["folklore", "single-result", "emerging", "contested",
            "established", "textbook"]
STATUS_NEEDS_GROUPS = {"established": 2, "textbook": 2, "contested": 2}

UNIT_KINDS = ["read", "survey", "idea", "explain", "interpret", "critique",
              "write", "referee"]

# Not everything worth citing has a DOI. A documentation page, a lecture note, a
# blog post and a book chapter are all legitimate sources; what differs is how
# settled a claim they can carry on their own.
SOURCE_KINDS = ["web", "blog", "docs", "book", "chapter", "thesis", "report",
                "dataset", "software", "talk", "personal-communication"]
STATUS_CEILING = {
    "book": "textbook", "chapter": "textbook", "report": "emerging",
    "thesis": "emerging", "docs": "established", "dataset": "established",
    "software": "established", "web": "emerging", "blog": "emerging",
    "talk": "emerging", "personal-communication": "single-result",
}

VOCABULARY = """## nullius: the commands

Run them as `./.nullius/bin/nullius <cmd>` from the project root.

    start <slug> <kind> "<question>" [--venue V] [--words N] [--artifact PATH]
        kind: read survey idea explain interpret critique write referee
    accept "<a question open right now>"   close "<the answer, with a locator>"
    trade "<what gets cut>"                artifact <path>      status   done

    cite <doi|arxiv|title>                 resolves, or refuses. never invent one
    cite <url> --kind <docs|blog|book|chapter|thesis|report|dataset|software|talk|web>
         --title "..."                     a source no index carries
    fulltext <citekey>                     a legal copy; caches text when there is one
    quote <citekey> "<text>"               verbatim against that cache, or refuses
    note <citekey> --depth <abstract|skim|method|replicated>
    claim "<text>" --warrant W --status S --strength X --source KEY [--locator L]
        warrant:  measured authors-claim replicated consensus inferred mine-unpublished
        status:   folklore single-result emerging contested established textbook
        strength: reports holds mechanism generalises   -- capped by read depth
    falsify "<idea>" "<why it died>"

    lit "<query>" --vocabulary <name> [--index openalex|arxiv|europepmc]
    screen <search-id> <include|exclude> "<reason>" --index N
    screen <search-id> exclude "<reason>" --below-citations 1     in bulk, by rule
    coverage        check <path>        doctor

Three vocabularies minimum on a survey: yours, the field's own terms taken from the first
hits, and one adjacent field that studies the same thing under another name. Silence is a
failed search, not novelty. `lit` ranks by citations per year, and work too new to have
earned any is shown separately -- judge that band on the abstract."""

DEFAULT_CONFIG = {
    "mode": "certain",
    "field": "",
    "contact": "",
    "default_venue": "",
    "vocabularies_suggested": 3,
    "indexes": ["openalex", "crossref", "arxiv", "europepmc"],
    "recent_years": 3,
    "rank_floor_citations": 1,
    "budget_overrun_ratio": 1.5,
    "cite_patterns": [
        r"\\cite[tpanyear]*\*?(?:\[[^\]]*\])*\{([^}]*)\}",
        r"\[@([A-Za-z0-9_:.-]+)",
        r"(?<![\w@])@([A-Za-z][A-Za-z0-9_:.-]{2,})",
    ],
    "draft_extensions": [".tex", ".md", ".markdown", ".txt", ".rst"],
    "attribution_cues": ["et al", "report", "reports", "reported", "suggest",
                         "suggests", "claim", "claims", "find", "finds", "found",
                         "observe", "observes", "according to"],
}


# --------------------------------------------------------------------- paths


def find_root(start=None):
    d = Path(start or os.getcwd()).resolve()
    for cand in [d, *d.parents]:
        if (cand / STATE_DIR / "config.json").is_file():
            return cand
    return None


def require_root():
    root = find_root()
    if root is None:
        die("no nullius project here. Run `nullius init` in the directory your "
            "research lives in.")
    return root


class Store:
    def __init__(self, root):
        self.root = Path(root)
        self.dir = self.root / STATE_DIR

    def p(self, *parts):
        return self.dir.joinpath(*parts)

    def read_json(self, name, default):
        f = self.p(name)
        if not f.is_file():
            return default
        try:
            return json.loads(f.read_text(encoding="utf-8"))
        except json.JSONDecodeError:
            return default

    def write_json(self, name, obj):
        f = self.p(name)
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(json.dumps(obj, indent=2, ensure_ascii=False) + "\n",
                     encoding="utf-8")

    @property
    def config(self):
        cfg = dict(DEFAULT_CONFIG)
        cfg.update(self.read_json("config.json", {}))
        return cfg

    @property
    def refs(self):
        return self.read_json("refs.json", {})

    def save_refs(self, refs):
        self.write_json("refs.json", refs)

    def claims(self):
        f = self.p("claims.jsonl")
        if not f.is_file():
            return []
        out = []
        for line in f.read_text(encoding="utf-8").splitlines():
            line = line.strip()
            if line:
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    pass
        return out

    def append_claim(self, claim):
        f = self.p("claims.jsonl")
        f.parent.mkdir(parents=True, exist_ok=True)
        with f.open("a", encoding="utf-8") as fh:
            fh.write(json.dumps(claim, ensure_ascii=False) + "\n")

    @property
    def unit(self):
        return self.read_json("work/current.json", None)

    def save_unit(self, unit):
        self.write_json("work/current.json", unit)

    def clear_unit(self):
        f = self.p("work/current.json")
        if f.is_file():
            f.unlink()

    def searches(self):
        d = self.p("searches")
        if not d.is_dir():
            return []
        out = []
        for f in sorted(d.glob("*.json")):
            try:
                out.append(json.loads(f.read_text(encoding="utf-8")))
            except json.JSONDecodeError:
                pass
        return out

    def save_search(self, search):
        self.write_json(f"searches/{search['id']}.json", search)

    def note_path(self, citekey):
        return self.p("papers", f"{citekey}.md")

    def note_depth(self, citekey):
        f = self.note_path(citekey)
        if not f.is_file():
            return None
        m = re.search(r"^read_depth:\s*([a-z]+)\s*$",
                      f.read_text(encoding="utf-8"), re.M)
        return m.group(1) if m else None


# ------------------------------------------------------------------- output


def die(msg, code=1):
    sys.stderr.write(f"nullius: {msg}\n")
    sys.exit(code)


def say(msg):
    sys.stdout.write(msg + "\n")


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def today():
    return datetime.now(timezone.utc).strftime("%Y-%m-%d")


# ---------------------------------------------------------------- indexes


def http_json(url):
    req = urllib.request.Request(url, headers={
        "User-Agent": "nullius (+https://github.com/tanyelai/nullius)",
        "Accept": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            return json.loads(r.read().decode("utf-8"))
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise RuntimeError(f"{url} returned HTTP {e.code}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"cannot reach {urllib.parse.urlsplit(url).netloc}: "
                           f"{e.reason}") from e


def http_text(url):
    req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            return r.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        if e.code in (403, 404):
            return None
        raise RuntimeError(f"{url} returned HTTP {e.code}") from e
    except urllib.error.URLError as e:
        raise RuntimeError(f"cannot reach "
                           f"{urllib.parse.urlsplit(url).netloc}: {e.reason}") from e


def strip_html(markup):
    markup = re.sub(r"<(script|style|head)[^>]*>.*?</\1>", " ", markup,
                    flags=re.S | re.I)
    markup = re.sub(r"<[^>]+>", " ", markup)
    markup = (markup.replace("&amp;", "&").replace("&lt;", "<")
              .replace("&gt;", ">").replace("&quot;", '"').replace("&#x2019;", "'")
              .replace("&nbsp;", " "))
    return re.sub(r"[ \t]+", " ", re.sub(r"\n{3,}", "\n\n", markup)).strip()


def openalex(path, contact, **params):
    if contact:
        params["mailto"] = contact
    q = urllib.parse.urlencode({k: v for k, v in params.items() if v not in (None, "")})
    return http_json(f"https://api.openalex.org/{path}" + (f"?{q}" if q else ""))


def crossref_lookup(doi, contact):
    """The DOI registration agency. More authoritative than an aggregator for
    metadata, and it carries the retraction and correction notices."""
    url = ("https://api.crossref.org/works/"
           + urllib.parse.quote(doi, safe="")
           + (f"?mailto={urllib.parse.quote(contact)}" if contact else ""))
    d = http_json(url)
    if not d or "message" not in d:
        return None
    m = d["message"]
    authors = []
    for a in m.get("author") or []:
        name = " ".join(x for x in [a.get("given"), a.get("family")] if x)
        if name:
            authors.append({"id": f"name:{slugify(name, 60)}", "name": name})
    updates = m.get("update-to") or []
    retracted = any((u.get("type") or "").lower() == "retraction" for u in updates)
    year = None
    for key in ("published", "published-print", "published-online", "issued"):
        parts = ((m.get(key) or {}).get("date-parts") or [[None]])[0]
        if parts and parts[0]:
            year = parts[0]
            break
    return {
        "openalex": None, "doi": (m.get("DOI") or "").lower(),
        "title": (m.get("title") or [""])[0],
        "year": year, "type": m.get("type"),
        "venue": (m.get("container-title") or [None])[0],
        "peer_reviewed": m.get("type") in ("journal-article", "proceedings-article",
                                           "book-chapter"),
        "retracted": retracted, "authors": authors, "institutions": [],
        "cited_by": m.get("is-referenced-by-count"),
        "oa_url": None, "referenced_works": [], "resolved_at": now(),
        "index": "crossref", "author_ids": "name",
    }


def europepmc_search(query, limit, counter=None):
    d = http_json("https://www.ebi.ac.uk/europepmc/webservices/rest/search?"
                  + urllib.parse.urlencode({
                      "query": query, "format": "json", "pageSize": limit,
                      "resultType": "core"}))
    if counter is not None:
        counter["europepmc"] = (d or {}).get("hitCount")
    out = []
    for r in ((d or {}).get("resultList") or {}).get("result", []):
        out.append({
            "index": "europepmc", "title": r.get("title", ""),
            "year": int(r.get("pubYear") or 0) or None,
            "doi": (r.get("doi") or "").lower() or None,
            "cited_by": r.get("citedByCount"),
            "venue": r.get("journalTitle"),
            "oa": r.get("isOpenAccess") == "Y",
            "pmcid": r.get("pmcid"),
        })
    return out


def arxiv_search(query, limit, raw=False, counter=None):
    url = ("https://export.arxiv.org/api/query?"
           + urllib.parse.urlencode({
               "search_query": query if raw else f"all:{query}",
               "max_results": limit, "sortBy": "relevance"}))
    req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            xml = r.read().decode("utf-8", "replace")
    except (urllib.error.URLError, urllib.error.HTTPError):
        return []
    if counter is not None:
        m = re.search(r"<opensearch:totalResults[^>]*>(\d+)<", xml)
        counter["arxiv"] = int(m.group(1)) if m else None
    out = []
    for entry in xml.split("<entry>")[1:]:
        def tag(name):
            m = re.search(rf"<{name}[^>]*>(.*?)</{name}>", entry, re.S)
            return re.sub(r"\s+", " ", m.group(1)).strip() if m else None
        aid = (tag("id") or "").rsplit("/", 1)[-1].split("v")[0]
        out.append({
            "index": "arxiv", "title": tag("title") or "",
            "year": int((tag("published") or "0000")[:4] or 0) or None,
            "doi": (tag("arxiv:doi") or "").lower() or None,
            "cited_by": None, "venue": "arXiv", "oa": True, "arxiv": aid,
        })
    return out


NOT_A_DOCUMENT = re.compile(r"\.(jpg|jpeg|png|gif|svg|webp|mp4|zip)(\?|$)", re.I)


def document_url(u):
    """An index's `best OA location` is sometimes a graphical abstract. An image is
    not a copy of the paper, and offering one as a route to the text is a lie."""
    return u if u and not NOT_A_DOCUMENT.search(u) else None


def unpaywall_locations(doi, contact):
    if not contact:
        return []
    d = http_json(f"https://api.unpaywall.org/v2/{urllib.parse.quote(doi, safe='')}"
                  f"?email={urllib.parse.quote(contact)}")
    out = []
    for loc in ([(d or {}).get("best_oa_location")]
                + ((d or {}).get("oa_locations") or [])):
        if not loc:
            continue
        for field in ("url_for_pdf", "url_for_landing_page", "url"):
            u = document_url(loc.get(field))
            if u and u not in [x[1] for x in out]:
                out.append((f"OA copy ({loc.get('host_type') or 'unknown'})", u))
    return out


def arxiv_copy_of(title):
    """Most paywalled work in these fields has a preprint. Finding it is the
    difference between reading the paper and citing its abstract."""
    want = norm_title(title)
    for hit in (arxiv_search(f'ti:"{title[:120]}"', 5, raw=True)
                or arxiv_search(title, 5)):
        if norm_title(hit.get("title")) == want and hit.get("arxiv"):
            return hit["arxiv"]
    return None


ARXIV_RE = re.compile(r"(?:arxiv[:/ ]|10\.48550/arxiv\.)?(\d{4}\.\d{4,5})(v\d+)?$", re.I)
DOI_RE = re.compile(r"(10\.\d{4,9}/[^\s\"'<>]+)", re.I)


def normalise_identifier(raw):
    """Return ('doi'|'arxiv'|'title', value)."""
    s = raw.strip().rstrip(".,;").replace("abs/", "")
    m = ARXIV_RE.search(s)
    if m:
        return "arxiv", m.group(1)
    m = DOI_RE.search(s)
    if m:
        return "doi", m.group(1).rstrip(".").lower()
    return "title", s


def arxiv_lookup(arxiv_id):
    """arXiv's own API. OpenAlex does not index every arXiv DOI -- 1706.03762 is
    absent -- so the id is turned into a title here and matched by title there."""
    url = ("https://export.arxiv.org/api/query?"
           + urllib.parse.urlencode({"id_list": arxiv_id, "max_results": 1}))
    req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
    try:
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            xml = r.read().decode("utf-8", "replace")
    except (urllib.error.URLError, urllib.error.HTTPError) as e:
        raise RuntimeError(f"cannot reach export.arxiv.org: {e}") from e
    if "<entry>" not in xml:
        return None
    entry = xml.split("<entry>", 1)[1]

    def tag(name):
        m = re.search(rf"<{name}[^>]*>(.*?)</{name}>", entry, re.S)
        return re.sub(r"\s+", " ", m.group(1)).strip() if m else None

    names = [re.sub(r"\s+", " ", n).strip()
             for n in re.findall(r"<author>\s*<name>(.*?)</name>", entry, re.S)]
    return {
        "title": tag("title") or "",
        "year": int((tag("published") or "0000")[:4] or 0) or None,
        "doi": tag("arxiv:doi"),
        "authors": names,
        "abs_url": f"https://arxiv.org/abs/{arxiv_id}",
    }


def record_from_arxiv(meta, arxiv_id):
    """A preprint OpenAlex has no record of. Author identity is matched by name
    here rather than by identifier, which is weaker, and the record says so."""
    return {
        "openalex": None, "arxiv": arxiv_id, "doi": meta.get("doi"),
        "title": meta["title"], "year": meta.get("year"), "type": "preprint",
        "venue": "arXiv", "peer_reviewed": False, "retracted": False,
        "authors": [{"id": f"name:{slugify(n, 60)}", "name": n}
                    for n in meta["authors"]],
        "institutions": [], "cited_by": None, "oa_url": meta["abs_url"],
        "referenced_works": [], "resolved_at": now(), "index": "arxiv",
        "author_ids": "name",
    }


def record_from_openalex(w):
    authors, institutions = [], []
    for a in w.get("authorships") or []:
        au = a.get("author") or {}
        if au.get("id"):
            authors.append({"id": au["id"], "name": au.get("display_name", "")})
        for inst in a.get("institutions") or []:
            if inst.get("id"):
                institutions.append(inst["id"])
    loc = (w.get("primary_location") or {}).get("source") or {}
    return {
        "openalex": w.get("id"),
        "doi": (w.get("doi") or "").replace("https://doi.org/", "") or None,
        "title": w.get("display_name") or w.get("title") or "",
        "year": w.get("publication_year"),
        "type": w.get("type"),
        "venue": loc.get("display_name"),
        "peer_reviewed": (w.get("type") not in ("preprint", None)
                          and not (loc.get("type") == "repository")),
        "retracted": bool(w.get("is_retracted")),
        "authors": authors,
        "institutions": sorted(set(institutions)),
        "cited_by": w.get("cited_by_count"),
        "oa_url": (w.get("open_access") or {}).get("oa_url"),
        "referenced_works": w.get("referenced_works") or [],
        "resolved_at": now(),
        "index": "openalex",
    }


def filter_safe(t):
    """OpenAlex reads `:` `,` `|` and `+` as filter operators, so a title carrying
    any of them returns HTTP 400 rather than the work. Most CS titles carry a colon."""
    return re.sub(r"\s+", " ", re.sub(r"[:,|+()\[\]]", " ", t or "")).strip()


def norm_title(t):
    return re.sub(r"[^a-z0-9]+", " ", (t or "").lower()).strip()


def slugify(text, keep=40):
    t = unicodedata.normalize("NFKD", text or "").encode("ascii", "ignore").decode()
    t = re.sub(r"[^a-zA-Z0-9]+", "-", t).strip("-").lower()
    return t[:keep] or "untitled"


def make_citekey(rec, existing):
    surname = ""
    if rec.get("authors"):
        parts = rec["authors"][0]["name"].split()
        if parts:
            surname = slugify(parts[-1], 20).replace("-", "")
    if not surname and rec.get("url"):
        host = urllib.parse.urlsplit(rec["url"]).netloc
        surname = slugify(re.sub(r"^www\.|\.(com|org|net|io|ai|edu|dev)$", "",
                                 host).split(".")[0], 20).replace("-", "")
    if not surname:
        stop = {"the", "a", "an", "on", "of", "in", "for", "and", "to"}
        words = [w for w in slugify(rec.get("title", ""), 80).split("-")
                 if w and w not in stop]
        surname = words[0] if words else "untitled"
    base = f"{surname}{rec.get('year') or 'nd'}"
    key, n = base, 0
    while key in existing:
        n += 1
        key = f"{base}{chr(ord('a') + n - 1)}"
    return key


# ----------------------------------------------------------------- helpers


def strip_markup(text):
    text = re.sub(r"```.*?```", " ", text, flags=re.S)
    text = re.sub(r"\\begin\{[^}]*\}|\\end\{[^}]*\}", " ", text)
    text = re.sub(r"\\[a-zA-Z@]+\*?(\[[^\]]*\])*(\{[^{}]*\})*", " ", text)
    text = re.sub(r"[%#*_`$]", " ", text)
    return text


def count_words(text):
    return len(re.findall(r"[A-Za-z0-9][A-Za-z0-9'\u2019-]*", strip_markup(text)))


def cited_keys(text, cfg):
    keys = set()
    for pat in cfg["cite_patterns"]:
        for m in re.finditer(pat, text):
            for k in m.group(1).split(","):
                k = k.strip()
                if k:
                    keys.add(k)
    return keys


def is_draft(path, cfg):
    return Path(path).suffix.lower() in cfg["draft_extensions"]


def author_groups(refs, citekeys):
    """How many mutually independent author groups these references represent."""
    sets = []
    for k in citekeys:
        rec = refs.get(k)
        if not rec:
            continue
        ids = {a["id"] for a in rec.get("authors", [])}
        placed = False
        for s in sets:
            if s & ids:
                s |= ids
                placed = True
                break
        if not placed and ids:
            sets.append(set(ids))
    return len(sets) if sets else (1 if citekeys else 0)


def tracked_drafts(store, unit):
    cfg = store.config
    out = []
    for rel in (unit or {}).get("artifacts", []):
        f = store.root / rel
        if f.is_file() and is_draft(f, cfg):
            out.append(f)
    return out


# ------------------------------------------------------------------ checks
# A finding is (severity, text). severity is "fact" (blocks in certain mode) or
# "chosen" (a threshold that was picked, so it is reported and marked as such).


def check_draft_text(store, text, label):
    cfg, refs = store.config, store.refs
    facts = []
    for key in sorted(cited_keys(text, cfg)):
        rec = refs.get(key)
        if rec is None:
            facts.append(f"{label}: `{key}` is cited but not resolved. "
                         f"Run `nullius cite <doi|arxiv|title>` first -- an "
                         f"identifier that never resolved cannot reach a draft.")
        elif rec.get("retracted"):
            facts.append(f"{label}: `{key}` is cited and the index records it as "
                         f"RETRACTED ({rec.get('title', '')[:60]}).")
    return facts


def check_attribution(store, text, label):
    """Reported, never blocking: a weak claim rendered as a bare assertion."""
    cfg = store.config
    out = []
    sentences = re.split(r"(?<=[.!?])\s+", strip_markup(text))
    for claim in store.claims():
        if claim.get("status") not in ("single-result", "folklore") and \
           claim.get("warrant") != "authors-claim":
            continue
        probe = " ".join(claim["text"].split()[:6]).lower()
        if len(probe) < 12:
            continue
        for s in sentences:
            low = s.lower()
            if probe in low:
                cued = any(c in low for c in cfg["attribution_cues"]) or \
                    any(src in s for src in claim.get("sources", []))
                if not cued:
                    out.append(f"{label}: claim {claim['id']} is "
                               f"`{claim.get('status')}` / "
                               f"`{claim.get('warrant')}` but reads as a bare "
                               f"assertion here. Attribute and situate it.")
                break
    return out


def unit_findings(store):
    """Everything the Stop gate asks. Returns (facts, chosen)."""
    cfg = store.config
    unit = store.unit
    facts, chosen = [], []
    if not unit:
        return facts, chosen

    if not unit.get("accept"):
        facts.append("no acceptance question. `nullius accept \"<what would "
                     "close this>\"` -- a unit with no stated close is a unit "
                     "that cannot be finished, only abandoned.")
    elif not unit.get("accept_closed"):
        facts.append(f"the acceptance question is still open:\n      "
                     f"\"{unit['accept']}\"\n    Close it with `nullius close "
                     f"\"<the answer, with its locator>\"`.")

    for f in tracked_drafts(store, unit):
        text = f.read_text(encoding="utf-8", errors="replace")
        rel = os.path.relpath(f, store.root)
        facts += check_draft_text(store, text, rel)
        chosen += check_attribution(store, text, rel)

    if unit.get("kind") == "survey":
        unscreened = sum(1 for s in store.searches()
                         for w in s.get("results", [])
                         if w.get("screened") is None)
        if unscreened:
            facts.append(f"this is a survey unit and {unscreened} retrieved "
                         f"works were never screened. `nullius coverage` lists "
                         f"them; screen or exclude each with a reason.")
        vocabs = len({s.get("vocabulary") for s in store.searches()
                      if s.get("vocabulary")})
        want = cfg["vocabularies_suggested"]
        if vocabs < want:
            chosen.append(f"{vocabs} query vocabular"
                          f"{'y' if vocabs == 1 else 'ies'} logged against a "
                          f"suggested {want}. Your framing is not the field's "
                          f"framing, and that is how a literature goes missing.")

    budget = (unit.get("budget") or {}).get("words")
    if budget and not tracked_drafts(store, unit):
        facts.append(f"a budget of {budget} words is declared and no draft is "
                     f"tracked against it, so nothing is measuring it. "
                     f"`nullius artifact <path>`, or drop the budget.")
    elif budget:
        words = sum(count_words(f.read_text(encoding="utf-8", errors="replace"))
                    for f in tracked_drafts(store, unit))
        if words > budget and not unit.get("trade"):
            facts.append(f"{words} words against a declared budget of {budget}. "
                         f"Over budget an addition is a trade, not an addition: "
                         f"record what it costs with `nullius trade \"<what "
                         f"gets cut>\"`, or subtract.")

    named = [c for c in store.claims()
             if c.get("independence_by_name")
             and c.get("status") in STATUS_NEEDS_GROUPS]
    if named:
        chosen.append(f"{len(named)} claim(s) reach their status through author "
                      f"names rather than identifiers. Two spellings of one "
                      f"person read as two groups, so the independence is "
                      f"weaker than the label suggests.")

    singles = [c for c in store.claims() if len(c.get("sources", [])) == 1]
    if singles:
        chosen.append(f"{len(singles)} claim(s) rest on a single source. That is "
                      f"a fact about the evidence, not a defect -- but it "
                      f"travels with the claim.")
    return facts, chosen


# ---------------------------------------------------------------- commands


def cmd_init(args):
    root = Path(args.path or os.getcwd()).resolve()
    store = Store(root)
    if store.p("config.json").is_file() and not args.force:
        die(f"already initialised at {store.dir}. Pass --force to rewrite config.")
    cfg = dict(DEFAULT_CONFIG)
    cfg["field"] = args.field or ""
    cfg["contact"] = args.email or ""
    store.write_json("config.json", cfg)
    for d in ("papers", "threads", "searches", "venues", "work", "cache"):
        store.p(d).mkdir(parents=True, exist_ok=True)
    tpl = Path(__file__).resolve().parent.parent / "templates"
    for name, dest in (("program.md", "program.md"), ("field.md", "field.md"),
                       ("venue.md", "venues/EXAMPLE.md")):
        src, out = tpl / name, store.p(dest)
        if src.is_file() and not out.is_file():
            out.parent.mkdir(parents=True, exist_ok=True)
            out.write_text(src.read_text(encoding="utf-8"), encoding="utf-8")
    for name, head in (("falsified.md", "# Falsified\n\nIdeas that died, and what "
                        "killed them. Injected before a write on the thread that "
                        "would repeat them.\n"),
                       ("decisions.md", "# Decisions\n\nMethodological choices, "
                        "with the alternative that was rejected.\n"),
                       ("terms.md", "# Terms\n\nWords this literature uses two "
                        "ways, and each paper's operationalisation.\n")):
        f = store.p(name)
        if not f.is_file():
            f.write_text(head, encoding="utf-8")
    shim = store.p("bin", "nullius")
    shim.parent.mkdir(parents=True, exist_ok=True)
    shim.write_text('#!/usr/bin/env bash\nexec python3 "%s" "$@"\n'
                    % Path(__file__).resolve(), encoding="utf-8")
    shim.chmod(0o755)
    gi = store.p(".gitignore")
    if not gi.is_file():
        gi.write_text("work/\ncache/\nbin/\n", encoding="utf-8")
    say(f"nullius: initialised {store.dir}")
    say(f"  run it from here as ./{STATE_DIR}/bin/nullius")
    if not cfg["contact"]:
        say("  set a contact email so the indexes rate-limit you politely:\n"
            "    nullius config contact you@example.org")
    say("  next: describe your field in .nullius/field.md, and your target "
        "venue in .nullius/venues/.")


def cmd_config(args):
    store = Store(require_root())
    cfg = store.read_json("config.json", {})
    if args.value is None:
        merged = store.config
        if args.key:
            say(json.dumps(merged.get(args.key), ensure_ascii=False))
        else:
            say(json.dumps(merged, indent=2, ensure_ascii=False))
        return
    val = args.value
    if val.isdigit():
        val = int(val)
    cfg[args.key] = val
    store.write_json("config.json", cfg)
    say(f"nullius: {args.key} = {val}")


def cmd_start(args):
    store = Store(require_root())
    if store.unit and not args.force:
        u = store.unit
        die(f"a unit is already open: {u['slug']} ({u['kind']}). Finish it with "
            f"`nullius done`, or pass --force to replace it.")
    if args.kind not in UNIT_KINDS:
        die(f"kind must be one of: {', '.join(UNIT_KINDS)}")
    budget = {}
    if args.words:
        budget["words"] = args.words
    unit = {
        "slug": args.slug, "kind": args.kind, "question": args.question,
        "venue": args.venue or store.config.get("default_venue") or "",
        "budget": budget, "accept": None, "accept_closed": False,
        "artifacts": list(args.artifact or []), "trade": None,
        "started": now(),
    }
    store.save_unit(unit)
    say(f"nullius: unit '{args.slug}' open ({args.kind})")
    say(f"  now declare what would close it, before the work:\n"
        f"    nullius accept \"<a question that is open right now>\"")


def cmd_accept(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit. `nullius start` first.")
    if unit.get("accept") and not args.force:
        die(f"this unit already accepts on:\n  \"{unit['accept']}\"\n"
            f"Changing it mid-flight is moving the goalposts. Pass --force if "
            f"the question itself turned out to be wrong.")
    unit["accept"] = args.question
    unit["accept_closed"] = False
    store.save_unit(unit)
    say(f"nullius: accepted. This unit is finishable when that question is "
        f"answered with a locator.")


def cmd_close(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    if not unit.get("accept"):
        die("nothing to close -- no acceptance question was declared.")
    # A locator is anything the next reader can turn to. A named part of a paper
    # counts; "yes it is" does not.
    locator = "|".join([
        r"\w+:[\w./#-]+",
        r"\u00a7\s*[\w.-]+",
        r"\b(?:table|fig(?:ure)?|section|sec|eq(?:uation)?|p{1,2}|page|chapter|"
        r"appendix|listing|algorithm|line)\.?\s*[\w.-]*\d",
        r"\b(?:abstract|introduction|methods?|materials|results?|discussion|"
        r"conclusions?|limitations|related work|appendix|supplement\w*)\b",
    ])
    if not re.search(locator, args.answer, re.I):
        die("that answer carries no locator. An acceptance answer has to be "
            "re-checkable by the next reader -- draft.tex:88, Table 2, \u00a73.1, "
            "p. 7, or a named section such as Methods. Otherwise it is an "
            "assertion about your own work, and you are the one person who "
            "cannot check it.")
    unit["accept_closed"] = True
    unit["accept_answer"] = args.answer
    store.save_unit(unit)
    say("nullius: acceptance closed.")


def cmd_trade(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    unit["trade"] = args.what
    store.save_unit(unit)
    say("nullius: trade recorded. The addition is now priced.")


def cmd_artifact(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    rel = os.path.relpath(Path(args.path).resolve(), store.root)
    if rel not in unit["artifacts"]:
        unit["artifacts"].append(rel)
    store.save_unit(unit)
    say(f"nullius: tracking {rel}")


def merge_records(primary, secondary):
    """Crossref is authoritative on metadata and retraction; OpenAlex is the only
    free route to author identifiers, which is what makes independence computable.
    Neither is privileged as a whole -- each contributes what it actually knows."""
    if primary and not secondary:
        return primary
    if secondary and not primary:
        return secondary
    out = dict(secondary)
    for k, v in primary.items():
        if v not in (None, "", [], False):
            out[k] = v
    if secondary.get("authors") and secondary.get("author_ids") != "name":
        out["authors"] = secondary["authors"]
        out.pop("author_ids", None)
    elif primary.get("authors"):
        out["authors"] = primary["authors"]
    out["retracted"] = bool(primary.get("retracted") or secondary.get("retracted"))
    out["index"] = "+".join(sorted({primary.get("index", ""),
                                    secondary.get("index", "")} - {""}))
    return out


def resolve_reference(cfg, identifier, first=False):
    """Reach the work by whatever route has it. Returns (record, note) where note
    is a line worth telling the user, or raises SystemExit through die()."""
    idx = cfg["indexes"]
    kind, value = normalise_identifier(identifier)
    arxiv_meta = None

    if kind == "arxiv":
        arxiv_meta = arxiv_lookup(value)
        if not arxiv_meta:
            die(f"arXiv has no record of '{value}'.")
        if arxiv_meta.get("doi"):
            kind, value = "doi", arxiv_meta["doi"].lower()
        else:
            kind, value = "title", arxiv_meta["title"]

    cross = oa = None
    if kind == "doi":
        if "crossref" in idx:
            cross = crossref_lookup(value, cfg["contact"])
        if "openalex" in idx:
            w = openalex(f"works/doi:{urllib.parse.quote(value, safe='')}",
                         cfg["contact"])
            oa = record_from_openalex(w) if w else None
        rec = merge_records(cross, oa)
        if rec:
            rec["matched_by"] = "doi"
    else:
        hits = []
        if "openalex" in idx:
            res = openalex("works", cfg["contact"],
                           **{"filter": f"title.search:{filter_safe(value)}",
                              "per-page": 5})
            hits = (res or {}).get("results") or []
        if arxiv_meta:
            want, year = norm_title(arxiv_meta["title"]), arxiv_meta.get("year")
            same = [h for h in hits
                    if norm_title(h.get("display_name")) == want
                    and (not year or not h.get("publication_year")
                         or abs(h["publication_year"] - year) <= YEAR_SLACK)]
            same.sort(key=lambda h: h.get("cited_by_count") or 0, reverse=True)
            rec = record_from_openalex(same[0]) if same else None
            if rec:
                rec["matched_by"] = "title+year"
        else:
            if len(hits) > 1 and not first:
                say("nullius: that title matches more than one work. Cite the one "
                    "you mean by its DOI:")
                for h in hits:
                    say(f"  {(h.get('doi') or '').replace('https://doi.org/', '') or '(no doi)':<34} "
                        f"{h.get('publication_year')}  {h.get('display_name', '')[:56]}")
                sys.exit(1)
            rec = record_from_openalex(hits[0]) if hits else None
            if rec:
                rec["matched_by"] = "title"

    note = None
    if not rec and arxiv_meta:
        rec = record_from_arxiv(arxiv_meta, normalise_identifier(identifier)[1])
        rec["matched_by"] = "arxiv-only"
        note = ("no index carries this beyond arXiv, so it is recorded as the "
                "preprint it is.")
    elif rec and arxiv_meta:
        rec["arxiv"] = normalise_identifier(identifier)[1]
        if not rec["authors"] and arxiv_meta["authors"]:
            rec["authors"] = [{"id": f"name:{slugify(n, 60)}", "name": n}
                              for n in arxiv_meta["authors"]]
            rec["author_ids"] = "name"
    if not rec:
        die(f"'{identifier}' did not resolve against {', '.join(idx)}. A "
            f"reference that cannot be resolved cannot be cited. If it is a "
            f"page, a book or a chapter rather than an indexed work, record it "
            f"as one:\n  nullius cite <url> --kind <"
            + "|".join(SOURCE_KINDS) + "> --title \"...\"")
    return rec, note


def cmd_cite(args):
    store = Store(require_root())
    cfg = store.config
    note = None

    if args.kind:
        if not args.title:
            die("a source the indexes do not carry needs --title. Its identity "
                "is the thing you are asserting, so it has to be written down.")
        rec = {
            "openalex": None, "doi": None, "url": args.identifier,
            "title": args.title, "year": args.year, "type": args.kind,
            "venue": args.venue or args.kind, "peer_reviewed": False,
            "retracted": False,
            "authors": [{"id": f"name:{slugify(a, 60)}", "name": a}
                        for a in (args.author or [])],
            "institutions": [], "cited_by": None, "oa_url": args.identifier,
            "referenced_works": [], "resolved_at": now(), "index": "manual",
            "author_ids": "name", "matched_by": "declared",
            "accessed": today(),
        }
        ceiling = STATUS_CEILING.get(args.kind)
        rec["status_ceiling"] = ceiling
        note = (f"a `{args.kind}` source. Nothing verified it for you, so it "
                f"carries what you saw on {today()} and no more"
                + (f", and it cannot support a status above `{ceiling}`."
                   if ceiling else "."))
    else:
        try:
            rec, note = resolve_reference(cfg, args.identifier, args.first)
        except RuntimeError as e:
            die(str(e))

    refs = store.refs
    existing = next((k for k, v in refs.items()
                     if (rec.get("openalex") and v.get("openalex") == rec["openalex"])
                     or (rec.get("doi") and v.get("doi") == rec["doi"])
                     or (rec.get("arxiv") and v.get("arxiv") == rec["arxiv"])
                     or (rec.get("url") and v.get("url") == rec["url"])), None)
    key = args.key or existing or make_citekey(rec, refs)
    refs[key] = rec
    store.save_refs(refs)

    say(f"nullius: {key}" + ("  RETRACTED" if rec["retracted"] else ""))
    say(f"  {rec['title'][:78]}")
    say(f"  {rec.get('venue') or '(no venue)'} · {rec.get('year')} · "
        f"{rec.get('type')} · {len(rec['authors'])} authors"
        + (f" · cited by {rec['cited_by']}" if rec.get("cited_by") else "")
        + f" · via {rec['index']}")
    if rec["retracted"]:
        say("  the index records this work as retracted. Citing it is a fact "
            "the gate will refuse.")
    if rec.get("matched_by") in ("title", "title+year"):
        say("  matched by title, not by identifier. Check it is the work you "
            "meant -- indexes carry duplicate records under one title.")
    if rec.get("author_ids") == "name":
        say("  authors carry no index identifier, so independence against this "
            "record is matched by name -- weaker, and defeated by a variant.")
    if rec.get("index") != "manual" and not rec.get("peer_reviewed"):
        say("  not peer reviewed. That travels with the claim.")
    if note:
        say(f"  {note}")


def pdf_to_text(url):
    """Opportunistic: poppler's pdftotext if the machine has it. Nothing here
    requires it, and a machine without it simply gets the URLs instead."""
    exe = shutil.which("pdftotext")
    if not exe:
        return None
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "nullius"})
        with urllib.request.urlopen(req, timeout=API_TIMEOUT) as r:
            blob = r.read()
    except Exception:
        return None
    if not blob.startswith(b"%PDF"):
        return None
    with tempfile.TemporaryDirectory() as d:
        f = Path(d) / "in.pdf"
        f.write_bytes(blob)
        try:
            out = subprocess.run([exe, "-q", str(f), "-"], capture_output=True,
                                 timeout=90)
        except Exception:
            return None
    text = out.stdout.decode("utf-8", "replace").strip()
    return text or None


ARXIV_URL_RE = re.compile(r"arxiv\.org/(?:abs|pdf)/(\d{4}\.\d{4,5})", re.I)


def cmd_fulltext(args):
    """Legal routes only, in the order most likely to have machine-readable text."""
    store = Store(require_root())
    cfg = store.config
    refs = store.refs
    rec = refs.get(args.citekey) or die(f"'{args.citekey}' is not resolved.")
    doi, urls = rec.get("doi"), []

    if doi:
        try:
            urls += unpaywall_locations(doi, cfg["contact"])
        except RuntimeError:
            pass
    if document_url(rec.get("oa_url")):
        urls.append(("index OA link", rec["oa_url"]))

    arxiv_id = rec.get("arxiv")
    if not arxiv_id:
        for _, u in urls:
            m = ARXIV_URL_RE.search(u)
            if m:
                arxiv_id = m.group(1)
                break
    if not arxiv_id and rec.get("title") and not doi:
        try:
            arxiv_id = arxiv_copy_of(rec["title"])
        except RuntimeError:
            arxiv_id = None
    if arxiv_id and arxiv_id != rec.get("arxiv"):
        rec["arxiv"] = arxiv_id
        refs[args.citekey] = rec
        store.save_refs(refs)
        say(f"nullius: a preprint copy exists -- arXiv:{arxiv_id}")
    if arxiv_id:
        urls = [("arXiv PDF", f"https://arxiv.org/pdf/{arxiv_id}"),
                ("arXiv abstract", f"https://arxiv.org/abs/{arxiv_id}")] + urls

    text, via = None, None
    if arxiv_id:
        try:
            html = http_text(f"https://arxiv.org/html/{arxiv_id}")
            if html and "<html" in html.lower():
                text, via = strip_html(html), f"arXiv HTML ({arxiv_id})"
        except RuntimeError:
            pass
    if not text and doi and "europepmc" in cfg["indexes"]:
        try:
            d = http_json("https://www.ebi.ac.uk/europepmc/webservices/rest/search?"
                          + urllib.parse.urlencode({"query": f"DOI:{doi}",
                                                    "format": "json",
                                                    "resultType": "core"}))
            res = ((d or {}).get("resultList") or {}).get("result") or []
            pmcid = next((r.get("pmcid") for r in res if r.get("pmcid")), None)
            if pmcid:
                urls.append(("Europe PMC",
                             f"https://europepmc.org/article/PMC/{pmcid}"))
                xml = http_text("https://www.ebi.ac.uk/europepmc/webservices/"
                                f"rest/{pmcid}/fullTextXML")
                if xml and "<" in xml:
                    text, via = strip_html(xml), f"Europe PMC ({pmcid})"
        except RuntimeError:
            pass
    if not text:
        for label, u in urls:
            got = pdf_to_text(u)
            if got and len(got.split()) > 500:
                text, via = got, f"pdftotext via {label}"
                break
    if doi:
        urls.append(("publisher", f"https://doi.org/{doi}"))

    if text:
        f = store.p("cache", "text", f"{args.citekey}.txt")
        f.parent.mkdir(parents=True, exist_ok=True)
        f.write_text(text, encoding="utf-8")
        say(f"nullius: {len(text.split())} words cached from {via}")
        say(f"  quotes can now be checked: nullius quote {args.citekey} \"<text>\"")
        say(f"  and the note can honestly go past `abstract` depth.")
        return

    say(f"nullius: no machine-readable full text for {args.citekey}.")
    seen_u = set()
    for label, u in urls:
        if u not in seen_u:
            seen_u.add(u)
            say(f"  {label:<24} {u}")
    if not shutil.which("pdftotext"):
        say("  install poppler (`brew install poppler`) and a PDF above becomes "
            "readable text; nothing here requires it.")
    say("  Other legal routes: your institution's proxy, the author's own copy "
        "or an email asking for one, and interlibrary loan.")
    say("  Until the text is here the note stays at `abstract` depth, which "
        "caps what may be claimed from it. That is the honest state, not a "
        "failure.")


def cmd_quote(args):
    store = Store(require_root())
    f = store.p("cache", "text", f"{args.citekey}.txt")
    if not f.is_file():
        die(f"no cached text for {args.citekey}. `nullius fulltext "
            f"{args.citekey}` -- and if it cannot be retrieved, the quote "
            f"cannot be checked and should not be presented as verbatim.")
    hay = re.sub(r"\s+", " ", f.read_text(encoding="utf-8")).lower()
    needle = re.sub(r"\s+", " ", args.text).strip().lower()
    if needle in hay:
        say(f"nullius: verbatim in {args.citekey}.")
        return
    say(f"nullius: NOT verbatim in the cached text of {args.citekey}.")
    words = needle.split()
    if len(words) > 4:
        head = " ".join(words[:4])
        i = hay.find(head)
        if i >= 0:
            say(f"  the opening matches; it diverges after. Cached nearby:")
            say(f"    ...{hay[i:i + len(needle) + 40]}...")
    sys.exit(2)


def cmd_note(args):
    store = Store(require_root())
    refs = store.refs
    if args.citekey not in refs:
        die(f"'{args.citekey}' is not resolved. `nullius cite` it first.")
    if args.depth not in READ_DEPTHS:
        die(f"depth must be one of: {', '.join(READ_DEPTHS)}")
    rec = refs[args.citekey]
    f = store.note_path(args.citekey)
    f.parent.mkdir(parents=True, exist_ok=True)
    if f.is_file():
        text = f.read_text(encoding="utf-8")
        text = re.sub(r"^read_depth:.*$", f"read_depth: {args.depth}", text,
                      count=1, flags=re.M)
        f.write_text(text, encoding="utf-8")
        say(f"nullius: {args.citekey} read_depth -> {args.depth}")
        return
    tpl = Path(__file__).resolve().parent.parent / "templates" / "paper-note.md"
    body = tpl.read_text(encoding="utf-8") if tpl.is_file() else \
        "read_depth: {depth}\n\n# {title}\n"
    fields = {
        "citekey": args.citekey, "depth": args.depth, "title": rec["title"],
        "year": rec.get("year"), "venue": rec.get("venue") or "",
        "doi": rec.get("doi") or "", "retracted": str(rec.get("retracted")).lower(),
        "peer_reviewed": str(rec.get("peer_reviewed")).lower(), "date": today(),
    }
    try:
        filled = body.format(**fields)
    except (KeyError, IndexError, ValueError):
        # templates/ is meant to be edited, and an edit may add a brace that
        # str.format cannot read. Substituting the known fields is better than
        # refusing to open a note.
        filled = body
        for k, v in fields.items():
            filled = filled.replace("{" + k + "}", str(v))
        say("  the template carries braces str.format could not read; the known "
            "fields were substituted and the rest left as written.")
    f.write_text(filled, encoding="utf-8")
    say(f"nullius: {os.path.relpath(f, store.root)} ({args.depth})")
    say("  the three mandatory fields are the point: the gap between claimed and "
        "evidenced, what it does not show, and what you still do not understand.")


def cmd_claim(args):
    store = Store(require_root())
    refs = store.refs
    if args.warrant not in WARRANTS:
        die(f"warrant must be one of: {', '.join(WARRANTS)}")
    if args.status not in STATUSES:
        die(f"status must be one of: {', '.join(STATUSES)}")
    if args.strength not in CLAIM_STRENGTHS:
        die(f"strength must be one of: {', '.join(CLAIM_STRENGTHS)}")
    if args.warrant == "assumed":
        die("there is no terminal `assumed` state. An assumption is an open "
            "question wearing another word, and the point is that you cannot "
            "finish inside one. Record it as a thread question instead.")

    sources = args.source or []
    if args.warrant != "mine-unpublished" and not sources:
        die("a claim needs at least one source. If it is your own unpublished "
            "data, say so: --warrant mine-unpublished.")
    for s in sources:
        if s not in refs:
            die(f"source '{s}' is not resolved. `nullius cite` it first.")
        if refs[s].get("retracted"):
            die(f"source '{s}' is recorded as retracted.")

    # read depth caps what the claim may assert
    for s in sources:
        depth = store.note_depth(s)
        if depth is None:
            die(f"no paper note for '{s}', so nothing records how far you read "
                f"it. `nullius note {s} --depth <{'|'.join(READ_DEPTHS)}>`.")
        if args.strength not in DEPTH_ALLOWS[depth]:
            die(f"'{s}' was read to depth `{depth}`, which supports "
                f"{', '.join(DEPTH_ALLOWS[depth])} -- not `{args.strength}`. "
                f"Read further, or make the weaker claim.")

    # a source kind the indexes do not carry caps how settled it can make a claim
    for src in sources:
        ceiling = refs[src].get("status_ceiling")
        if ceiling and STATUSES.index(args.status) > STATUSES.index(ceiling):
            die(f"'{src}' is a `{refs[src].get('type')}` source, which supports "
                f"`{ceiling}` at most, not `{args.status}`. It can still carry "
                f"the claim -- at what it is worth.")

    # independence caps how settled the claim may be called
    need = STATUS_NEEDS_GROUPS.get(args.status)
    if need:
        groups = author_groups(refs, sources)
        if groups < need:
            die(f"`{args.status}` needs {need} independent author groups; these "
                f"{len(sources)} source(s) form {groups}. Sharing an author is "
                f"not independent replication -- use `emerging` or "
                f"`single-result`, or add a group.")

    by_name = [x for x in sources if refs[x].get("author_ids") == "name"]
    claims = store.claims()
    claim = {
        "id": f"c{len(claims) + 1:03d}", "text": args.text,
        "warrant": args.warrant, "status": args.status,
        "strength": args.strength, "sources": sources,
        "locator": args.locator or "", "created": now(),
        "independence_by_name": by_name,
    }
    store.append_claim(claim)
    say(f"nullius: {claim['id']} recorded ({args.warrant} / {args.status} / "
        f"{args.strength})")
    if args.status in ("single-result", "folklore") or args.warrant == "authors-claim":
        say("  this may not be written as a bare assertion. Attribute and "
            "situate it in the prose.")
    if by_name and need:
        say(f"  independence here rests on name matching for "
            f"{', '.join(by_name)} -- two spellings of one person would read as "
            f"two groups. Weaker than it looks.")


def cmd_thread(args):
    """The unit that outlives a context window. Promised by the documentation and,
    until this existed, written by nothing."""
    store = Store(require_root())
    d = store.p("threads")
    d.mkdir(parents=True, exist_ok=True)
    if not args.slug:
        threads = sorted(d.glob("*.md"))
        if not threads:
            say("nullius: no threads yet. `nullius thread <slug>` opens one.")
            return
        for f in threads:
            head = f.read_text(encoding="utf-8")
            q = re.search(r"^## The question\s*\n+(.+)$", head, re.M)
            say(f"  {f.stem:<24} {(q.group(1).strip()[:52] if q else '(no question yet)')}")
        return
    f = d / f"{slugify(args.slug, 48)}.md"
    if f.is_file():
        say(f"nullius: {os.path.relpath(f, store.root)} already exists.")
        return
    tpl = Path(__file__).resolve().parent.parent / "templates" / "thread.md"
    body = tpl.read_text(encoding="utf-8") if tpl.is_file() else "# Thread\n"
    f.write_text(body.replace("<slug>", args.slug), encoding="utf-8")
    say(f"nullius: {os.path.relpath(f, store.root)}")
    say("  the current best answer carries its warrant and its status. Without "
        "those it is a note to self, and a note to self is what you already had.")


def cmd_falsify(args):
    store = Store(require_root())
    f = store.p("falsified.md")
    prev = f.read_text(encoding="utf-8") if f.is_file() else "# Falsified\n"
    f.write_text(prev.rstrip() + f"\n\n## {args.idea}\n\n- **killed by:** "
                 f"{args.why}\n- **when:** {today()}\n", encoding="utf-8")
    say("nullius: recorded. This is now injected before a write on that thread.")


def impact(rec):
    """Citations per year since publication. Raw counts rank a 2015 paper above a
    2026 one that matters more, which is the wrong ordering for a live search."""
    c, y = rec.get("cited_by"), rec.get("year")
    if c is None or not y:
        return None
    return c / max(1, datetime.now(timezone.utc).year - y + 1)


def cmd_lit(args):
    store = Store(require_root())
    cfg = store.config
    wanted = args.index or cfg["indexes"]
    hits, reached, failed, matched = [], [], [], {}

    if "openalex" in wanted:
        try:
            res = openalex("works", cfg["contact"], search=args.query,
                           **{"per-page": args.limit, "sort": "cited_by_count:desc"})
            for h in (res or {}).get("results") or []:
                hits.append({
                    "index": "openalex", "title": h.get("display_name", ""),
                    "year": h.get("publication_year"),
                    "doi": (h.get("doi") or "").replace("https://doi.org/", "") or None,
                    "cited_by": h.get("cited_by_count"),
                    "venue": ((h.get("primary_location") or {}).get("source")
                              or {}).get("display_name"),
                    "oa": bool((h.get("open_access") or {}).get("is_oa")),
                })
            matched["openalex"] = ((res or {}).get("meta") or {}).get("count")
            reached.append("openalex")
        except RuntimeError as e:
            failed.append(f"openalex ({e})")
    if "arxiv" in wanted:
        try:
            hits += arxiv_search(args.query, args.limit, counter=matched)
            reached.append("arxiv")
        except RuntimeError as e:
            failed.append(f"arxiv ({e})")
    if "europepmc" in wanted:
        try:
            hits += europepmc_search(args.query, args.limit, counter=matched)
            reached.append("europepmc")
        except RuntimeError as e:
            failed.append(f"europepmc ({e})")

    seen, merged = {}, []
    for h in hits:
        k = h.get("doi") or norm_title(h.get("title"))
        if k in seen:
            prev = merged[seen[k]]
            if prev.get("cited_by") is None and h.get("cited_by") is not None:
                prev["cited_by"] = h["cited_by"]
            prev["index"] = "+".join(sorted({prev["index"], h["index"]}))
            if h.get("arxiv"):
                prev["arxiv"] = h["arxiv"]
            continue
        seen[k] = len(merged)
        merged.append(dict(h, screened=None, reason=None))

    # arXiv and Europe PMC do not always carry a citation count, and a row with no
    # count cannot be ranked. One batched lookup fills them rather than N calls.
    blind = [r for r in merged if r.get("cited_by") is None and r.get("doi")]
    if blind and "openalex" in cfg["indexes"]:
        for chunk in [blind[i:i + 25] for i in range(0, len(blind), 25)]:
            try:
                res = openalex("works", cfg["contact"], **{
                    "filter": "doi:" + "|".join(r["doi"] for r in chunk),
                    "per-page": len(chunk)})
            except RuntimeError:
                break
            by_doi = {(w.get("doi") or "").replace("https://doi.org/", "").lower():
                      w for w in (res or {}).get("results") or []}
            for r in chunk:
                w = by_doi.get(r["doi"].lower())
                if w:
                    r["cited_by"] = w.get("cited_by_count")
                    r["index"] = "+".join(sorted({r["index"], "openalex"}))

    this_year = datetime.now(timezone.utc).year
    cutoff = this_year - cfg["recent_years"]
    ranked = sorted(merged, key=lambda r: (impact(r) is not None, impact(r) or 0),
                    reverse=True)
    recent = [r for r in ranked
              if (r.get("year") or 0) > cutoff and (r.get("cited_by") or 0)
              < cfg["rank_floor_citations"]]
    recent_ids = {id(r) for r in recent}
    body = [r for r in ranked if id(r) not in recent_ids]
    ordered = body + recent

    search = {
        "id": f"{today()}-{slugify(args.query, 32)}", "query": args.query,
        "vocabulary": args.vocabulary or slugify(args.query, 32),
        "indexes": reached, "unreachable": failed, "matched": matched,
        "when": now(), "found": max([v for v in matched.values() if v] or [0]),
        "retrieved": len(ordered), "results": ordered,
    }
    store.save_search(search)

    per = ", ".join(f"{k} {v if v is not None else '?'}" for k, v in matched.items())
    say(f"nullius: retrieved {len(ordered)} distinct works. The indexes report "
        f"{per}"
        + (f"; unreachable: {', '.join(failed)}" if failed else ""))
    say(f"  what you retrieved is a sample of that, and the gap is the finding -- "
        f"not the four you read")
    say(f"  ranked by citations per year -- raw counts would put a 2015 paper "
        f"above a 2026 one that matters more")
    for i, r in enumerate(ordered):
        if recent and r is recent[0]:
            say(f"  -- too new to rank on citations ({cutoff + 1}-{this_year}); "
                f"judge these on the abstract --")
        imp = impact(r)
        cite = "  n/a" if r.get("cited_by") is None else f"{r['cited_by']:>5}"
        per = "     " if imp is None else f"{imp:>5.0f}"
        say(f"  [{i}] {r.get('year') or '????'} {cite} {per}/yr  "
            f"{(r.get('title') or '')[:56]}")
        say(f"      {r.get('doi') or r.get('arxiv') or '(no id)'}  "
            f"{(r.get('venue') or '')[:44]}  via {r['index']}")
    say(f"  screen one: nullius screen {search['id']} "
        f"<include|exclude> \"<reason>\" --index N")
    say(f"  or in bulk:  nullius screen {search['id']} exclude "
        f"\"no citations yet, deprioritised\" --below-citations 1")


def cmd_screen(args):
    store = Store(require_root())
    f = store.p("searches", f"{args.search}.json")
    if not f.is_file():
        die(f"no search '{args.search}'.")
    search = json.loads(f.read_text(encoding="utf-8"))
    rows = search["results"]

    if args.below_citations is not None or args.all_remaining:
        # One recorded rule beats forty individual judgements, and it is the more
        # reproducible of the two: the next reader can see what was applied.
        touched, unknown = 0, 0
        for r in rows:
            if r["screened"] is not None:
                continue
            if args.all_remaining:
                hit = True
            elif r.get("cited_by") is None:
                # An index that does not report a count has not reported zero. Sweeping
                # these away drops exactly the preprints the count could not be found for.
                unknown += 1
                continue
            else:
                hit = r["cited_by"] < args.below_citations
            if hit:
                r["screened"] = args.decision
                r["reason"] = args.reason
                r["by_rule"] = ("all-remaining" if args.all_remaining
                                else f"cited_by<{args.below_citations}")
                touched += 1
        search.setdefault("rules", []).append({
            "rule": ("all-remaining" if args.all_remaining
                     else f"cited_by<{args.below_citations}"),
            "decision": args.decision, "reason": args.reason,
            "applied_to": touched, "when": now()})
        store.save_search(search)
        left = sum(1 for r in rows if r["screened"] is None)
        say(f"nullius: {args.decision}d {touched} by rule. {left} unscreened.")
        if unknown:
            say(f"  {unknown} left alone: no index reported a citation count for "
                f"them, and unknown is not zero. Judge those on the abstract.")
        if args.decision == "exclude" and args.below_citations:
            say("  recorded as a rule, so it is one exclusion criterion rather "
                "than forty judgements -- and a reader can disagree with it "
                "in one place.")
        return

    if args.index is None:
        die("give an index, or a bulk rule: --below-citations N, --all-remaining.")
    if not 0 <= args.index < len(rows):
        die(f"index out of range (0..{len(rows) - 1}).")
    rows[args.index]["screened"] = args.decision
    rows[args.index]["reason"] = args.reason
    store.save_search(search)
    left = sum(1 for r in rows if r["screened"] is None)
    say(f"nullius: [{args.index}] {args.decision}. {left} unscreened in this search.")


def cmd_coverage(args):
    store = Store(require_root())
    cfg = store.config
    searches = store.searches()
    if not searches:
        say("nullius: no searches logged yet. `nullius lit \"<query>\"`.")
        return
    found = max([s.get("found", 0) for s in searches] or [0])
    results = [r for s in searches for r in s.get("results", [])]
    screened = sum(1 for r in results if r["screened"] is not None)
    included = sum(1 for r in results if r["screened"] == "include")
    vocabs = {s.get("vocabulary") for s in searches if s.get("vocabulary")}
    years = [r["year"] for r in results if r.get("year")]
    refs = store.refs
    groups = author_groups(refs, list(refs.keys()))
    want = cfg["vocabularies_suggested"]

    say(f"matched      {found:<6} the largest number any one index reported")
    say(f"retrieved    {len(results):<6} screened {screened:<5} included {included}"
        f"  unscreened {len(results) - screened}")
    say(f"vocabularies {len(vocabs):<6} of {want} suggested"
        + ("" if len(vocabs) >= want else
           "  -- try the field's terms, not yours"))
    say(f"groups       {groups:<6} across {len(refs)} resolved reference(s)"
        + ("" if groups > 1 or len(refs) < 2 else
           "  -- shared authors, not independent"))
    if years:
        say(f"years        {min(years)}-{max(years)}")
    unscreened = [(s["id"], i, r) for s in searches
                  for i, r in enumerate(s.get("results", []))
                  if r["screened"] is None]
    if unscreened:
        say("")
        say("unscreened:")
        for sid, i, r in unscreened[:20]:
            say(f"  {sid} [{i}]  {r['year']}  {(r['title'] or '')[:58]}")
        if len(unscreened) > 20:
            say(f"  ... and {len(unscreened) - 20} more")


def cmd_check(args):
    store = Store(require_root())
    path = Path(args.path).resolve()
    if not path.is_file():
        die(f"{args.path} is not a file.")
    text = path.read_text(encoding="utf-8", errors="replace")
    rel = os.path.relpath(path, store.root)
    facts = check_draft_text(store, text, rel)
    chosen = check_attribution(store, text, rel)
    words = count_words(text)
    say(f"{rel}: {words} words, "
        f"{len(cited_keys(text, store.config))} citation key(s)")
    for f in facts:
        say(f"  FACT   {f}")
    for c in chosen:
        say(f"  chosen {c}")
    if not facts and not chosen:
        say("  clean.")
    sys.exit(2 if facts else 0)


def cmd_status(args):
    store = Store(require_root())
    unit = store.unit
    refs, claims = store.refs, store.claims()
    say(f"project   {store.root}")
    say(f"field     {store.config.get('field') or '(unset -- .nullius/field.md)'}")
    say(f"ledger    {len(refs)} reference(s), {len(claims)} claim(s)")
    if not unit:
        say("unit      none open. Nothing about the current work is being "
            "checked.")
        return
    say(f"unit      {unit['slug']} ({unit['kind']})"
        + (f" -> {unit['venue']}" if unit.get("venue") else ""))
    say(f"question  {unit['question']}")
    say(f"accept    {unit.get('accept') or '(not declared)'}"
        + ("  [closed]" if unit.get("accept_closed") else ""))
    if unit.get("budget", {}).get("words"):
        words = sum(count_words(f.read_text(encoding='utf-8', errors='replace'))
                    for f in tracked_drafts(store, unit))
        say(f"budget    {words} / {unit['budget']['words']} words")
    facts, chosen = unit_findings(store)
    say("")
    if facts:
        say("the stop gate refuses on these facts:")
        for f in facts:
            say(f"  - {f}")
    if chosen:
        say("reported, and marked as chosen rather than measured:")
        for c in chosen:
            say(f"  - {c}")
    if not facts and not chosen:
        say("finishable.")


def cmd_done(args):
    store = Store(require_root())
    unit = store.unit or die("no open unit.")
    facts, _ = unit_findings(store)
    if facts and not args.force:
        say("nullius: not finishable yet --")
        for f in facts:
            say(f"  - {f}")
        sys.exit(1)
    log = store.p("work", "log.jsonl")
    log.parent.mkdir(parents=True, exist_ok=True)
    unit["finished"] = now()
    with log.open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(unit, ensure_ascii=False) + "\n")
    store.clear_unit()
    say(f"nullius: '{unit['slug']}' closed.")


def cmd_doctor(args):
    store_root = find_root()
    ok = True
    say(f"python    {sys.version.split()[0]}")
    if sys.version_info < (3, 8):
        say("  FAIL nullius needs Python 3.8 or newer.")
        ok = False
    if store_root is None:
        say("project   none found from here. `nullius init`.")
        return sys.exit(1)
    store = Store(store_root)
    cfg = store.config
    say(f"project   {store_root}")
    say(f"mode      {cfg['mode']}")
    say(f"contact   {cfg['contact'] or '(unset -- the indexes will rate-limit harder)'}")
    for d in ("papers", "searches", "venues", "threads"):
        n = len(list(store.p(d).glob("*"))) if store.p(d).is_dir() else 0
        say(f"{d:<9} {n}")
    refs = store.refs
    retracted = [k for k, v in refs.items() if v.get("retracted")]
    if retracted:
        say(f"  retracted references present: {', '.join(retracted)}")
        ok = False
    orphan = [c["id"] for c in store.claims()
              for s in c.get("sources", []) if s not in refs]
    if orphan:
        say(f"  claims citing unresolved sources: {', '.join(sorted(set(orphan)))}")
        ok = False
    for k in refs:
        if store.note_depth(k) is None:
            say(f"  no paper note for {k}, so claims from it are capped at nothing")
    try:
        openalex("works", cfg["contact"], search="test", **{"per-page": 1})
        say("openalex  reachable")
    except RuntimeError as e:
        say(f"openalex  UNREACHABLE ({e}). Local gates still work; `cite` and "
            f"`lit` will not.")
    sys.exit(0 if ok else 1)


# -------------------------------------------------------------------- hooks
# Hooks read local state only. A hook that makes a network call hangs the session,
# so resolution happens in `cite`, deliberately, and the gates check what it wrote.


def hook_payload():
    try:
        return json.loads(sys.stdin.read() or "{}")
    except json.JSONDecodeError:
        return {}


def hook_session_start(payload):
    root = find_root(payload.get("cwd"))
    if root is None:
        return 0
    store = Store(root)
    plugin = Path(__file__).resolve().parent.parent
    parts = []
    inv = plugin / "invariants"
    if inv.is_dir():
        for f in sorted(inv.glob("*.md")):
            parts.append(f.read_text(encoding="utf-8").rstrip())
    unit = store.unit
    lines = []
    if unit:
        lines.append(f"Open unit: {unit['slug']} ({unit['kind']}) -- "
                     f"{unit['question']}")
        lines.append(f"  accept: {unit.get('accept') or 'NOT DECLARED'}"
                     + ("  [closed]" if unit.get("accept_closed") else ""))
        facts, chosen = unit_findings(store)
        for f in facts:
            lines.append(f"  fact:   {f}")
        for c in chosen:
            lines.append(f"  chosen: {c}")
    else:
        lines.append("No unit is open, so nothing about the current work is "
                     "being checked. For anything past reading one paper: "
                     "`nullius start <slug> <kind> \"<question>\"`.")
    refs = store.refs
    lines.append(f"Ledger: {len(refs)} reference(s), {len(store.claims())} claim(s).")
    tdir = store.p("threads")
    if tdir.is_dir():
        names = sorted(f.stem for f in tdir.glob("*.md"))
        if names:
            lines.append(f"Threads open: {', '.join(names[:10])}"
                         + (f" (+{len(names) - 10} more)" if len(names) > 10 else ""))
    fals = store.p("falsified.md")
    if fals.is_file():
        killed = re.findall(r"^## (.+)$", fals.read_text(encoding="utf-8"), re.M)
        if killed:
            lines.append("Already falsified, do not re-propose: "
                         + "; ".join(killed[:8]))
    parts.append("## nullius: this project right now\n\n" + "\n".join(lines))
    parts.append(VOCABULARY)
    sys.stdout.write("\n\n".join(parts) + "\n")
    return 0


def hook_pre_write(payload):
    root = find_root(payload.get("cwd"))
    if root is None:
        return 0
    store = Store(root)
    cfg = store.config
    ti = payload.get("tool_input") or {}
    target = ti.get("file_path") or ""
    if not target or not is_draft(target, cfg):
        return 0
    text = ti.get("content") or ti.get("new_string") or ""
    if not text:
        return 0
    rel = os.path.relpath(Path(target).resolve(), store.root) \
        if Path(target).is_absolute() else target
    facts = check_draft_text(store, text, rel)
    if facts and cfg["mode"] in ("certain", "block"):
        sys.stderr.write("nullius refuses this write:\n  - "
                         + "\n  - ".join(facts) + "\n")
        return 2
    notes = []
    for key in sorted(cited_keys(text, cfg)):
        depth = store.note_depth(key)
        if depth:
            notes.append(f"{key}: read to `{depth}`")
    if notes:
        emit_context("nullius: read depth of what this cites -- "
                     + "; ".join(notes) + ". A claim may not exceed it.")
    return 0


def emit_context(text):
    sys.stdout.write(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "additionalContext": text}}) + "\n")


def hook_stop(payload):
    root = find_root(payload.get("cwd"))
    if root is None:
        return 0
    store = Store(root)
    if store.unit is None:
        return 0
    facts, chosen = unit_findings(store)
    mode = store.config["mode"]
    if facts and mode in ("certain", "block"):
        sys.stderr.write(
            f"nullius: unit '{store.unit['slug']}' is not finishable yet.\n  - "
            + "\n  - ".join(facts)
            + (("\n  and, on thresholds that were chosen rather than measured:"
                "\n  - " + "\n  - ".join(chosen)) if chosen else "")
            + "\n")
        return 2
    if chosen and mode == "block":
        sys.stderr.write("nullius: only chosen thresholds remain:\n  - "
                         + "\n  - ".join(chosen) + "\n")
        return 2
    if chosen:
        # A threshold picked rather than measured does not get to end a turn. It goes
        # to the person, who can judge it, through the one channel Stop has for them.
        sys.stdout.write(json.dumps({"systemMessage": (
            f"nullius: '{store.unit['slug']}' is finishable on the facts. These rest "
            f"on thresholds that were chosen rather than measured, so they are "
            f"reported rather than enforced:\n  - " + "\n  - ".join(chosen))}) + "\n")
    return 0


def cmd_hook(args):
    payload = hook_payload()
    fn = {"session-start": hook_session_start, "pre-write": hook_pre_write,
          "stop": hook_stop}.get(args.event)
    if fn is None:
        return 0
    try:
        sys.exit(fn(payload))
    except SystemExit:
        raise
    except Exception as e:  # a broken gate must never wedge a session
        sys.stderr.write(f"nullius: gate error ({type(e).__name__}: {e})\n")
        sys.exit(0)


# --------------------------------------------------------------------- main


def build_parser():
    p = argparse.ArgumentParser(prog="nullius",
                                description="take nobody's word for it")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("init", help="scaffold .nullius/ here")
    s.add_argument("path", nargs="?")
    s.add_argument("--field"); s.add_argument("--email")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_init)

    s = sub.add_parser("config", help="read or set a config key")
    s.add_argument("key", nargs="?"); s.add_argument("value", nargs="?")
    s.set_defaults(fn=cmd_config)

    s = sub.add_parser("start", help="open a work unit")
    s.add_argument("slug"); s.add_argument("kind", choices=UNIT_KINDS)
    s.add_argument("question")
    s.add_argument("--venue"); s.add_argument("--words", type=int)
    s.add_argument("--artifact", action="append")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_start)

    s = sub.add_parser("accept", help="declare what would close this unit")
    s.add_argument("question"); s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_accept)

    s = sub.add_parser("close", help="answer the acceptance question")
    s.add_argument("answer"); s.set_defaults(fn=cmd_close)

    s = sub.add_parser("trade", help="price an addition made over budget")
    s.add_argument("what"); s.set_defaults(fn=cmd_trade)

    s = sub.add_parser("artifact", help="track a draft against this unit")
    s.add_argument("path"); s.set_defaults(fn=cmd_artifact)

    s = sub.add_parser("cite", help="resolve an identifier, or record a source "
                                     "no index carries")
    s.add_argument("identifier", help="DOI, arXiv id, title, or a URL with --kind")
    s.add_argument("--key"); s.add_argument("--first", action="store_true")
    s.add_argument("--kind", choices=SOURCE_KINDS,
                   help="for a page, book, chapter, thesis, dataset or talk")
    s.add_argument("--title"); s.add_argument("--venue")
    s.add_argument("--year", type=int)
    s.add_argument("--author", action="append")
    s.set_defaults(fn=cmd_cite)

    s = sub.add_parser("fulltext", help="find a legal full text, and cache it")
    s.add_argument("citekey"); s.set_defaults(fn=cmd_fulltext)

    s = sub.add_parser("quote", help="check a quote verbatim against cached text")
    s.add_argument("citekey"); s.add_argument("text")
    s.set_defaults(fn=cmd_quote)

    s = sub.add_parser("note", help="open a paper note at a read depth")
    s.add_argument("citekey")
    s.add_argument("--depth", required=True, choices=READ_DEPTHS)
    s.set_defaults(fn=cmd_note)

    s = sub.add_parser("claim", help="record a claim with its warrant and status")
    s.add_argument("text")
    s.add_argument("--warrant", required=True, choices=WARRANTS)
    s.add_argument("--status", required=True, choices=STATUSES)
    s.add_argument("--strength", default="reports", choices=CLAIM_STRENGTHS)
    s.add_argument("--source", action="append"); s.add_argument("--locator")
    s.set_defaults(fn=cmd_claim)

    s = sub.add_parser("thread", help="open or list a research thread")
    s.add_argument("slug", nargs="?"); s.set_defaults(fn=cmd_thread)

    s = sub.add_parser("falsify", help="record an idea that died, and why")
    s.add_argument("idea"); s.add_argument("why"); s.set_defaults(fn=cmd_falsify)

    s = sub.add_parser("lit", help="search the indexes and log the protocol")
    s.add_argument("query"); s.add_argument("--vocabulary")
    s.add_argument("--limit", type=int, default=10)
    s.add_argument("--index", action="append",
                   choices=["openalex", "arxiv", "europepmc"],
                   help="default: whatever .nullius/config.json lists")
    s.set_defaults(fn=cmd_lit)

    s = sub.add_parser("screen", help="include or exclude retrieved works")
    s.add_argument("search")
    s.add_argument("decision", choices=["include", "exclude"])
    s.add_argument("reason")
    s.add_argument("--index", type=int)
    s.add_argument("--below-citations", type=int, dest="below_citations",
                   help="apply to everything unscreened under this many citations")
    s.add_argument("--all-remaining", action="store_true", dest="all_remaining")
    s.set_defaults(fn=cmd_screen)

    s = sub.add_parser("coverage", help="the counts, and what is unscreened")
    s.set_defaults(fn=cmd_coverage)

    s = sub.add_parser("check", help="run the write guards over a draft")
    s.add_argument("path"); s.set_defaults(fn=cmd_check)

    s = sub.add_parser("status", help="why the stop gate is refusing")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("done", help="close the unit")
    s.add_argument("--force", action="store_true"); s.set_defaults(fn=cmd_done)

    s = sub.add_parser("doctor", help="is this project still set up correctly")
    s.set_defaults(fn=cmd_doctor)

    s = sub.add_parser("_hook", help=argparse.SUPPRESS)
    s.add_argument("event"); s.set_defaults(fn=cmd_hook)
    return p


def main():
    args = build_parser().parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
